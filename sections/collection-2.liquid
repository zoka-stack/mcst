{{ 'collection-2.css' | asset_url | stylesheet_tag }}

{% style %}
  #shopify-section-{{ section.id }} {
    --heading-color: {{ section.settings.heading_color | color_extract: 'red' }}, {{ section.settings.heading_color | color_extract: 'green' }}, {{ section.settings.heading_color | color_extract: 'blue' }};
    --color-body: {{ section.settings.text_color | color_extract: 'red' }}, {{ section.settings.text_color | color_extract: 'green' }}, {{ section.settings.text_color | color_extract: 'blue' }};
    --ap-nextap-buttonprev-background: var(--color-body);
    --ap-nextap-buttonprev-color: var(--section-background);
    --section-background: {{ section.settings.section_background }};
    --section-collage-column: {{ section.settings.number_column }};
    --color-btn: {{ section.settings.color_btn }};
    --color-btn-hover: {{ section.settings.color_btn_hover }};
    --bg-text: {{ section.settings.bg_text }};
  }
  {% for block in section.blocks %}
    #block-{{ block.id }}-{{ forloop.index }} {
      --heading-color: {{ block.settings.heading_color }};
      --sub-color: {{ block.settings.sub_color }};
      --des-color: {{ block.settings.des_color }};
      --color-body: {{ block.settings.text_color }};
      --section-block-overlay: {{ block.settings.overlay | color_extract: 'red' }}, {{ block.settings.overlay | color_extract: 'green' }}, {{ block.settings.overlay | color_extract: 'blue' }};
      --section-block-overlay-opacity: {{ block.settings.overlay_opacity | divided_by: 10.0 }};
    }
  {% endfor %}

  {% if section.settings.background-image != blank %}
  .collection-2 {
    background-color: #2A2A2A;
    background-image: url({{ section.settings.background-image | image_url: width: 2000 }});
  }
  {% endif %}
{% endstyle %}

<section class="section section--flush collection-2">
  <div class="section__color-wrapper">
    <div class="vertical-breather">
      {% if section.settings.heading != blank %}
        <header class="section__header ">
          <div class="text-container">
            <h3 class="heading h{{ section.settings.heading_size_range }}">{{ section.settings.heading }}</h3>
          </div>
          {% if section.settings.description %}
            <div class="heading-description {{ section.settings.description_size }}">
              {{ section.settings.description }}
            </div>
          {% endif %}
        </header>
      {% endif %}
      
      <ap-collectionlist reveal-on-scroll="" class="list-collections list-collections--collage ap-object-loaded">
        <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
          <div class="list-collections__item-list collection-2-content">
            {% for block in section.blocks %}
              {% case block.type %}

              {%- when 'collection' -%}
              {% liquid
                assign _link = block.settings.collection.url
                if block.settings.link != ''
                  assign _link = block.settings.link
                endif
              %}
              <div class="collection-1-row">
                <a id="block-{{ block.id }}-{{ forloop.index }}" href="{{ _link }}" class="list-collections__item {% if block.settings.highlight %}list-collections__item--highlight{% endif %}  has-overlay image-zoom">
                  <div class="list-collections__item-image-wrapper">
                    {% if block.settings.featured_image != blank %}
                      <img class="list-collections__item-image" reveal="" loading="lazy" 
                        sizes="(max-width: 740px) 80vw, (max-width: 999px) 60vw, 425px"
                        alt="" 
                        src="{%- if block.settings.featured_image.width >= 3000 -%}{{ block.settings.featured_image | image_url: width: 3000, crop: 'center' }} 3000w,{%- endif -%}
                          {{ block.settings.featured_image | image_url }} {{ block.settings.featured_image.width }}w"
                        src="{{ block.settings.featured_image | image_url: width: 1500 }}"
                        height="{{ block.settings.featured_image.height }}"
                        width="{{ block.settings.featured_image.width }}">
                    {% else %}
                      <div class="list-collections__item-image">
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      </div>
                    {% endif %}
                  </div>
                  <div class="list-collections__item-info text-container
                  {%- if block.settings.text_align == 'left' -%}{{ 'text-start' | prepend: ' ' }}
                  {%- elsif block.settings.text_align == 'center' -%}{{ 'text-center' | prepend: ' ' }}
                  {%- elsif block.settings.text_align == 'right' -%}{{ 'text-end' | prepend: ' ' }}
                  {%- endif -%}
                  ">
                    {% if block.settings.sub_title != blank %}
                      <p class="sub-title" reveal="">{{ block.settings.sub_title }}</p>
                    {% endif %}

                    <p class="heading h{{ block.settings.heading_size_range }} heading-title" reveal="">
                      {% if block.settings.heading != blank %}
                        {{- block.settings.heading -}}
                      </p>
                    {% else %}
                      {{- block.settings.collection.title | escape -}}</p>
                    {% endif %}

                    {% if block.settings.des_collection != blank %}
                      <p class="des-collection" reveal="">{{ block.settings.des_collection }}</p>
                    {% endif %}  
                      
                    {% if block.settings.heading_2 != blank %}
                      <span class="heading {{ block.settings.heading_2_size }} link btn-base" reveal="">
                        {{ block.settings.heading_2 }}
                        {% render 'icon-arrow-2' %}
                      </span>
                    {% endif %}
                  </div>
                </a>
              </div>

              {%- when 'collection-2-row' -%}
              {% liquid
                assign _link = block.settings.collection.url
                assign _link2 = block.settings.collection2.url
                if block.settings.link != ''
                  assign _link = block.settings.link
                endif
                if block.settings.link2 != ''
                  assign _link2 = block.settings.link2
                endif
              %}
              <div class="collecton-2-row">
                <div class="collection-top">
                  <a id="block-{{ block.id }}-{{ forloop.index }}" href="{{ _link }}" class="list-collections__item has-overlay image-zoom">
                    <div class="list-collections__item-image-wrapper">
                      {% if block.settings.featured_image != blank %}
                        <img class="list-collections__item-image" reveal="" loading="lazy" 
                          sizes="(max-width: 740px) 80vw, (max-width: 999px) 60vw, 425px"
                          alt="" 
                          src="{{ block.settings.featured_image | image_url: width: block.settings.featured_image.width }}" 
                          srcset="{%- if block.settings.featured_image.width >= 3000 -%}{{ block.settings.featured_image | image_url: width: 3000, crop: 'center' }} 3000w,{%- endif -%}
                            {{ block.settings.featured_image | image_url }} {{ block.settings.featured_image.width }}w"
                          src="{{ block.settings.featured_image | image_url: width: 1500 }}"
                          height="{{ block.settings.featured_image.height }}"
                          width="{{ block.settings.featured_image.width }}">
                      {% else %}
                        <div class="list-collections__item-image">
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {% endif %}
                    </div>
                    <div class="list-collections__item-info text-container
                    {%- if block.settings.text_align == 'left' -%}{{ 'text-start' | prepend: ' ' }}
                    {%- elsif block.settings.text_align == 'center' -%}{{ 'text-center' | prepend: ' ' }}
                    {%- elsif block.settings.text_align == 'right' -%}{{ 'text-end' | prepend: ' ' }}
                    {%- endif -%}
                    ">
                      {% if block.settings.sub_title != blank %}
                        <p class="sub-title" reveal="">{{ block.settings.sub_title }}</p>
                      {% endif %}

                      <p class="heading heading-title" reveal="">
                        {% if block.settings.heading != blank %}
                          {{- block.settings.heading -}}
                        </p>
                      {% else %}
                        {{- block.settings.collection.title | escape -}}</p>
                      {% endif %}

                      {% if block.settings.des_collection != blank %}
                        <p class="des-collection" reveal="">{{ block.settings.des_collection }}</p>
                      {% endif %}  
                        
                      {% if block.settings.heading_2 != blank %}
                        <span class="heading link btn-base" reveal="">
                          {{ block.settings.heading_2 }}
                          {% render 'icon-arrow-2' %}
                        </span>
                      {% endif %}
                    </div>
                  </a>
                </div>
                <div class="collection-bot">
                  <a id="block-{{ block.id }}-{{ forloop.index }}" href="{{ _link2 }}" class="list-collections__item has-overlay image-zoom">
                    <div class="list-collections__item-image-wrapper">
                      {% if block.settings.featured_image2 != blank %}
                        <img class="list-collections__item-image" reveal="" loading="lazy" 
                          sizes="(max-width: 740px) 80vw, (max-width: 999px) 60vw, 425px"
                          alt="" 
                          src="{{ block.settings.featured_image2 | image_url: width: block.settings.featured_image2.width }}" 
                          srcset="{%- if block.settings.featured_image2.width >= 3000 -%}{{ block.settings.featured_image2 | image_url: width: 3000, crop: 'center' }} 3000w,{%- endif -%}
                            {{ block.settings.featured_image2 | image_url }} {{ block.settings.featured_image2.width }}w"
                          src="{{ block.settings.featured_image2 | image_url: width: 1500 }}"
                          height="{{ block.settings.featured_image2.height }}"
                          width="{{ block.settings.featured_image2.width }}">
                      {% else %}
                        <div class="list-collections__item-image">
                          {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                      {% endif %}
                    </div>
                    <div class="list-collections__item-info text-container
                    {%- if block.settings.text_align2 == 'left' -%}{{ 'text-start' | prepend: ' ' }}
                    {%- elsif block.settings.text_align2 == 'center' -%}{{ 'text-center' | prepend: ' ' }}
                    {%- elsif block.settings.text_align2 == 'right' -%}{{ 'text-end' | prepend: ' ' }}
                    {%- endif -%}
                    ">
                      {% if block.settings.sub_title2 != blank %}
                        <p class="sub-title" reveal="">{{ block.settings.sub_title2 }}</p>
                      {% endif %}

                      <p class="heading heading-title" reveal="">
                        {% if block.settings.heading2 != blank %}
                          {{- block.settings.heading2 -}}
                        </p>
                      {% else %}
                        {{- block.settings.collection2.title | escape -}}</p>
                      {% endif %}

                      {% if block.settings.des_collection2 != blank %}
                        <p class="des-collection" reveal="">{{ block.settings.des_collection2 }}</p>
                      {% endif %}  
                        
                      {% if block.settings.heading_2_2 != blank %}
                        <span class="heading link btn-base" reveal="">
                          {{ block.settings.heading_2_2 }}
                          {% render 'icon-arrow-2' %}
                        </span>
                      {% endif %}
                    </div>
                  </a>
                </div>
              </div>

              {% endcase %}
            {% endfor %}
          </div>
        </div>
      </ap-collectionlist>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection-2.name",
  "tag": "section",
  "class": "section section-collection-2",
  "max_blocks": 15,
  "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "Full width",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "background-image",
      "label": "t:sections.all.background-image.label"
    },
    {
      "type": "color",
      "id": "section_background",
      "default": "#ffffff",
      "label": "t:sections.all.section_background.label"
    },
    {
      "type": "color",
      "id": "heading_color",
      "default": "#282828",
      "label": "t:sections.all.heading_color.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#282828",
      "label": "t:sections.all.text_color.label"
    },
    {
      "type": "color",
      "id": "bg_text",
      "default": "#000",
      "label": "Background Text"
    },
    {
      "type": "color",
      "id": "color_btn",
      "label": "Color button"
    },
    {
      "type": "color",
      "id": "color_btn_hover",
      "label": "Color Button hover"
    },
    {
      "type": "range",
      "id": "number_column",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 2,
      "label": "t:sections.all.number_column.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "range",
      "id": "heading_size_range",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 1,
      "label": "t:sections.all.heading_size_range.label"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.all.description.label"
    },
    {
      "type": "select",
      "id": "description_size",
      "options": [
        {
          "value": "heading--xxsmall",
          "label": "t:sections.all.description_size.options__1.label"
        },
        {
          "value": "heading--xsmall",
          "label": "t:sections.all.description_size.options__2.label"
        },
        {
          "value": "heading--small",
          "label": "t:sections.all.description_size.options__3.label"
        },
        {
          "value": "",
          "label": "t:sections.all.description_size.options__4.label"
        },
        {
          "value": "heading--large",
          "label": "t:sections.all.description_size.options__5.label"
        }
      ],
      "default": "heading--xsmall",
      "label": "t:sections.all.description_size.label"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.all.collection.label"
        },
        {
          "type": "image_picker",
          "id": "featured_image",
          "label": "t:sections.all.featured_image.label"
        },
        {
          "type": "checkbox",
          "id": "highlight",
          "default": false,
          "label": "t:sections.all.highlight.label"
        },
        {
          "type": "text",
          "id": "sub_title",
          "default": "Sub Title",
          "label": "t:sections.all.sub_title.label"
        },
        {
          "type": "color",
          "id": "sub_color",
          "default": "#282828",
          "label": "t:sections.all.sub_title.label"
        },
        {
          "type": "color",
          "id": "heading_color",
          "default": "#282828",
          "label": "t:sections.all.heading_color.label"
        },
        {
          "type": "liquid",
          "id": "heading",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "range",
          "id": "heading_size_range",
          "min": 1,
          "max": 6,
          "step": 1,
          "default": 4,
          "label": "t:sections.all.heading_size_range.label"
        },
        {
          "type": "text",
          "id": "des_collection",
          "label": "t:sections.all.des_collection.label"
        },
        {
          "type": "color",
          "id": "des_color",
          "default": "#282828",
          "label": "t:sections.all.des_color.label"
        },
        {
          "type": "text",
          "id": "heading_2",
          "label": "t:sections.all.heading_2.label"
        },
        {
          "type": "select",
          "id": "heading_2_size",
          "options": [
            {
              "value": "heading--xxsmall",
              "label": "t:sections.all.heading_2_size.options__1.label"
            },
            {
              "value": "heading--xsmall",
              "label": "t:sections.all.heading_2_size.options__2.label"
            },
            {
              "value": "heading--small",
              "label": "t:sections.all.heading_2_size.options__3.label"
            },
            {
              "value": "",
              "label": "t:sections.all.heading_2_size.options__4.label"
            },
            {
              "value": "heading--large",
              "label": "t:sections.all.heading_2_size.options__5.label"
            }
          ],
          "default": "heading--xsmall",
          "label": "t:sections.all.heading_2_size.label"
        },
        {
          "type": "color",
          "id": "text_color",
          "default": "#282828",
          "label": "t:sections.all.text_color.label"
        },
        {
          "type": "color",
          "id": "overlay",
          "default": "#000000",
          "label": "t:sections.all.overlay.label"
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 10,
          "step": 1,
          "default": 1,
          "label": "t:sections.all.overlay_opacity.label"
        },
        {
          "type": "text",
          "id": "link",
          "label": "t:sections.all.link.label"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "t:sections.all.text_align.label",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "t:sections.all.text_align.options__1.label"
            },
            {
              "value": "center",
              "label": "t:sections.all.text_align.options__2.label"
            },
            {
              "value": "right",
              "label": "t:sections.all.text_align.options__3.label"
            }
          ]
        }
      ]
    },
    {
      "type": "collection-2-row",
      "name": "Collection 2 Row",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:sections.all.collection.label"
        },
        {
          "type": "image_picker",
          "id": "featured_image",
          "label": "t:sections.all.featured_image.label"
        },
        {
          "type": "text",
          "id": "sub_title",
          "default": "Sub Title",
          "label": "t:sections.all.sub_title.label"
        },
        {
          "type": "liquid",
          "id": "heading",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "text",
          "id": "des_collection",
          "label": "t:sections.all.des_collection.label"
        },
        {
          "type": "text",
          "id": "heading_2",
          "label": "t:sections.all.heading_2.label"
        },
        {
          "type": "text",
          "id": "link",
          "label": "t:sections.all.link.label"
        },
        {
          "type": "select",
          "id": "text_align",
          "label": "t:sections.all.text_align.label",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "t:sections.all.text_align.options__1.label"
            },
            {
              "value": "center",
              "label": "t:sections.all.text_align.options__2.label"
            },
            {
              "value": "right",
              "label": "t:sections.all.text_align.options__3.label"
            }
          ]
        },
        {
          "type": "header",
          "content": "Setting Collection bot"
        },
        {
          "type": "collection",
          "id": "collection2",
          "label": "t:sections.all.collection.label"
        },
        {
          "type": "image_picker",
          "id": "featured_image2",
          "label": "t:sections.all.featured_image.label"
        },
        {
          "type": "text",
          "id": "sub_title2",
          "default": "Sub Title",
          "label": "t:sections.all.sub_title.label"
        },
        {
          "type": "liquid",
          "id": "heading2",
          "label": "t:sections.all.heading.label"
        },
        {
          "type": "text",
