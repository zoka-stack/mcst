{%- style -%}
  #mcst-coming-soon-{{ section.id }} {
    position: relative;
    min-height: 100vh;
    background: #282828;
    color: #ffffff;
    font-family: var(--body-font-family, sans-serif);
  }

  #mcst-coming-soon-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3Cpattern id='chicago-flag' x='0' y='0' width='100' height='100' patternUnits='userSpaceOnUse'%3E%3Crect width='100' height='100' fill='%23ffffff' opacity='0.02'/%3E%3Crect y='0' width='100' height='33.33' fill='%23000000' opacity='0.02'/%3E%3Crect y='66.66' width='100' height='33.33' fill='%23000000' opacity='0.02'/%3E%3Ccircle cx='50' cy='50' r='8' fill='%23FF0000' opacity='0.03'/%3E%3C/pattern%3E%3C/defs%3E%3Crect width='100' height='100' fill='url(%23chicago-flag)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    opacity: 0.3;
    pointer-events: none;
    z-index: 0;
  }

  #mcst-coming-soon-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px);
    pointer-events: none;
    z-index: 0;
  }

  #mcst-coming-soon-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-sticky-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: #000000;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 2rem 0;
    transition: all 0.3s ease;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-sticky-header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--container-distance, 2rem);
  }

  #mcst-coming-soon-{{ section.id }} .mcst-sticky-header__logo {
    font-size: 2rem;
    font-weight: 700;
    color: #ffffff;
    text-decoration: none;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    font-family: var(--hd-font-family, sans-serif);
  }

  #mcst-coming-soon-{{ section.id }} .mcst-sticky-header nav a {
    transition: opacity 0.3s ease;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-sticky-header nav a:hover {
    opacity: 1;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero {
    position: relative;
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 8rem 0;
    overflow: hidden;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero__background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: 0;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero__overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    z-index: 1;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero__content {
    position: relative;
    z-index: 2;
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero h1 {
    color: #aeef00;
    font-family: var(--hd-font-family, sans-serif);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-weight: 700;
    font-size: 5rem;
    line-height: 1.1;
    margin-bottom: 2rem;
    text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero h2 {
    color: #ffffff;
    font-size: 2.4rem;
    font-weight: 400;
    line-height: 1.4;
    margin-bottom: 3rem;
    text-shadow: 1px 1px 3px rgba(0, 0, 0, 0.5);
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero .button {
    background-color: #ffffff;
    color: #000000;
    border: 2px solid #000000;
    padding: 1.5rem 3rem;
    font-size: 1.4rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    transition: all 0.3s ease;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero .button:hover {
    background-color: #000000;
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero__rotating-text {
    margin-top: 2rem;
    font-size: 1.4rem;
    opacity: 0.8;
    min-height: 2.5rem;
    transition: opacity 0.3s ease;
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-section {
    padding: 6rem 0;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-section.visible {
    opacity: 1;
    transform: translateY(0);
  }

  #mcst-coming-soon-{{ section.id }} .mcst-section h2 {
    color: #aeef00;
    font-family: var(--hd-font-family, sans-serif);
    text-transform: uppercase;
    letter-spacing: 0;
    font-weight: 400;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-section h3 {
    color: #aeef00;
    font-family: var(--hd-font-family, sans-serif);
    text-transform: uppercase;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-value-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-value-card {
    padding: 2rem;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-value-card h3 {
    color: #aeef00;
    font-family: var(--hd-font-family, sans-serif);
    text-transform: uppercase;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hooks {
    margin-top: 3rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hooks__note {
    font-size: 1.2rem;
    opacity: 0.7;
    margin-top: 1rem;
    font-style: italic;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 3rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange__column h3 {
    margin-bottom: 1.5rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange__column ul {
    list-style: none;
    padding: 0;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange__column li {
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange__column li:last-child {
    border-bottom: none;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange__column h3 {
    color: #aeef00;
    font-family: var(--hd-font-family, sans-serif);
    text-transform: uppercase;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-faq {
    margin-top: 3rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-signup {
    background: rgba(255, 255, 255, 0.05);
    padding: 4rem 2rem;
    border-radius: 8px;
    margin-top: 4rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-signup h2 {
    color: #aeef00;
    font-family: var(--hd-font-family, sans-serif);
    text-transform: uppercase;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-signup__privacy {
    font-size: 1.2rem;
    opacity: 0.7;
    margin-top: 1rem;
    text-align: center;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-footer {
    text-align: center;
    padding: 4rem 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    margin-top: 6rem;
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .accordion {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  #mcst-coming-soon-{{ section.id }} .accordion__title {
    color: #aeef00;
    font-family: var(--hd-font-family, sans-serif);
    text-transform: uppercase;
  }

  #mcst-coming-soon-{{ section.id }} .accordion__content {
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .accordion summary {
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .accordion summary:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  #mcst-coming-soon-{{ section.id }} .field__input {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .field__input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  #mcst-coming-soon-{{ section.id }} .field__label {
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .rte {
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }} .rte p {
    color: #ffffff;
  }

  @media screen and (max-width: 749px) {
    #mcst-coming-soon-{{ section.id }} .mcst-sticky-header__inner {
      flex-direction: column;
      gap: 1.5rem;
      text-align: center;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-sticky-header nav {
      flex-direction: column;
      gap: 1rem;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-hero {
      min-height: 60vh;
      padding: 4rem 0;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-hero h1 {
      font-size: 3rem;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-hero h2 {
      font-size: 1.8rem;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-section {
      padding: 4rem 0;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-feature-blocks {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-gear-highlights {
      grid-template-columns: 1fr;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-why-scroll {
      min-height: 300vh;
    }
  }
{%- endstyle -%}

<div id="mcst-coming-soon-{{ section.id }}">
  <!-- Sticky Header -->
  <div class="mcst-sticky-header">
    <div class="mcst-sticky-header__inner">
      <div>
        <div class="mcst-sticky-header__logo">MCST</div>
        <nav style="display: flex; gap: 2rem; margin-top: 0.5rem; font-size: 1.2rem;">
          <a href="#mcst-mission-{{ section.id }}" style="color: #ffffff; text-decoration: none; opacity: 0.8;">The Mission</a>
          <a href="#mcst-gear-{{ section.id }}" style="color: #ffffff; text-decoration: none; opacity: 0.8;">The Gear</a>
          <a href="#mcst-request-{{ section.id }}" style="color: #ffffff; text-decoration: none; opacity: 0.8;">Request a City</a>
        </nav>
      </div>
      <a href="#mcst-signup-{{ section.id }}" class="button button--primary mcst-scroll-to-signup" style="background-color: #000000; color: #ffffff; border: 1px solid #ffffff; text-transform: uppercase;">
        JOIN THE FOUNDERS CIRCLE
      </a>
    </div>
  </div>

  <!-- Hero -->
  <section class="mcst-hero mcst-section">
      {% if section.settings.hero_background_image != blank %}
        <img src="{{ section.settings.hero_background_image | image_url: width: 2000 }}" alt="Chicago" class="mcst-hero__background">
      {% endif %}
      <div class="mcst-hero__overlay"></div>
      <div class="mcst-hero__content">
        <h1 class="h0">WEAR YOUR CITY. FUND YOUR BLOCK.</h1>
        <h2 class="h2">Most brands take from the city. We're built to reinvest in it.</h2>
        <div class="rte" style="margin-top: 2rem; font-size: 1.8rem; max-width: 80rem; margin-left: auto; margin-right: auto; line-height: 1.6;">
          <p>Millions of dollars are made every year selling "Chicago" to tourists while our neighborhoods struggle for funding. We're changing the math. Premium gear. Gritty designs. Productive pride.</p>
        </div>
        <div style="margin-top: 4rem; display: flex; gap: 2rem; justify-content: center; flex-wrap: wrap;">
          <a href="#mcst-gear-{{ section.id }}" class="button">
            View the 2026 Collection
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" style="margin-left: 0.5rem; display: inline-block; vertical-align: middle;">
              <path d="M6 12L10 8L6 4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>
          <a href="#mcst-why-{{ section.id }}" class="button" style="background-color: transparent; color: #ffffff; border: 2px solid #ffffff;">
            Learn Why We Started
          </a>
        </div>
      </div>
    </section>

  <div class="page-width">
    <!-- The Why - Interactive Scroll Section -->
    <section id="mcst-why-{{ section.id }}" class="mcst-section mcst-why-scroll" style="position: relative; min-height: 400vh;">
      <div class="mcst-why-slides" style="position: sticky; top: 0; height: 100vh; overflow: hidden;">
        <div class="mcst-why-slide" data-slide="1" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.5s ease;">
          <div class="page-width" style="text-align: center; z-index: 2; position: relative;">
            <h2 class="h1" style="margin-bottom: 2rem;">The Problem</h2>
            <p class="rte" style="font-size: 2rem; max-width: 80rem; margin: 0 auto; line-height: 1.6;">Every "Chicago" shirt bought at a tourist shop sends local capital out of state. The city's identity is sold, but the neighborhoods get nothing.</p>
          </div>
          <div class="mcst-why-slide-bg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 1;"></div>
        </div>
        <div class="mcst-why-slide" data-slide="2" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.5s ease;">
          <div class="page-width" style="text-align: center; z-index: 2; position: relative;">
            <h2 class="h1" style="margin-bottom: 2rem;">The Disconnect</h2>
            <p class="rte" style="font-size: 2rem; max-width: 80rem; margin: 0 auto; line-height: 1.6;">Pride shouldn't just be a feeling, it should be an investment.</p>
          </div>
          <div class="mcst-why-slide-bg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 1;"></div>
        </div>
        <div class="mcst-why-slide" data-slide="3" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.5s ease;">
          <div class="page-width" style="text-align: center; z-index: 2; position: relative;">
            <h2 class="h1" style="margin-bottom: 2rem;">The Solution</h2>
            <p class="rte" style="font-size: 2rem; max-width: 80rem; margin: 0 auto; line-height: 1.6;">My City Stands Together. We created a "Civic Infrastructure" model. We use high-end apparel to capture that spend and redirect it back to the local groups actually doing the work on your street.</p>
          </div>
          <div class="mcst-why-slide-bg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 1;"></div>
        </div>
        <div class="mcst-why-slide" data-slide="4" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity 0.5s ease;">
          <div class="page-width" style="text-align: center; z-index: 2; position: relative;">
            <h2 class="h1" style="margin-bottom: 2rem;">The Mission</h2>
            <p class="rte" style="font-size: 2rem; max-width: 80rem; margin: 0 auto; line-height: 1.6;">By 2027, we want every city in America to have its own self-funding engine. We're starting here. We're starting now.</p>
          </div>
          <div class="mcst-why-slide-bg" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.7); z-index: 1;"></div>
        </div>
      </div>
    </section>

    <!-- The Gear -->
    <section id="mcst-gear-{{ section.id }}" class="mcst-section" style="background: #ffffff; color: #000000;">
      <div class="page-width">
        <h2 class="h1" style="color: #aeef00; text-align: center; margin-bottom: 2rem;">PREMIUM GEAR. MADE TO ORDER.</h2>
        <div class="rte" style="margin-top: 2rem; font-size: 1.8rem; max-width: 80rem; margin-left: auto; margin-right: auto; line-height: 1.8; color: #000000; text-align: center;">
          <p>We don't do mass production. We don't have warehouses full of waste. Every piece is custom-printed on heavyweight, high-durability fabrics designed for the resilience of the people who wear them.</p>
        </div>
        <div class="mcst-gear-highlights" style="margin-top: 4rem; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4rem; max-width: 1000px; margin-left: auto; margin-right: auto;">
          <div style="text-align: center;">
            <h3 class="h3" style="margin-bottom: 1rem; color: #000000; font-size: 2rem; font-weight: 600;">The Flag Series</h3>
            <p style="font-size: 1.6rem; color: #666666;">A gritty mashup of the iconic stars and bars.</p>
          </div>
          <div style="text-align: center;">
            <h3 class="h3" style="margin-bottom: 1rem; color: #000000; font-size: 2rem; font-weight: 600;">Technical Outerwear</h3>
            <p style="font-size: 1.6rem; color: #666666;">Built for the Windy City elements.</p>
          </div>
          <div style="text-align: center;">
            <h3 class="h3" style="margin-bottom: 1rem; color: #000000; font-size: 2rem; font-weight: 600;">Foundational Basics</h3>
            <p style="font-size: 1.6rem; color: #666666;">Heavyweight fleece and tri-blend essentials.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature Blocks -->
    <section class="mcst-section" style="padding: 6rem 0; background: #ffffff; color: #000000;">
      <div class="page-width">
        <div class="mcst-feature-blocks" style="display: grid; grid-template-columns: repeat(4, 1fr); gap: 4rem; max-width: 1200px; margin: 0 auto;">
          <div style="text-align: center;">
            <div style="width: 48px; height: 48px; margin: 0 auto 1.5rem; background: #000000; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#aeef00" stroke-width="2">
                <path d="M3 21h18M5 21V7l8-4v18M19 21V11l-6-4"/>
                <path d="M9 9v0M9 15v0M15 11v0"/>
              </svg>
            </div>
            <h3 class="h3" style="margin-bottom: 0.5rem; color: #000000; font-size: 1.6rem; font-weight: 600;">CITY PRIDE.</h3>
            <p style="font-size: 1.4rem; color: #666666;">Own your urban identity.</p>
          </div>
          <div style="text-align: center;">
            <div style="width: 48px; height: 48px; margin: 0 auto 1.5rem; background: #000000; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#aeef00" stroke-width="2">
                <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
              </svg>
            </div>
            <h3 class="h3" style="margin-bottom: 0.5rem; color: #000000; font-size: 1.6rem; font-weight: 600;">PREMIUM QUALITY.</h3>
            <p style="font-size: 1.4rem; color: #666666;">Designed to last.</p>
          </div>
          <div style="text-align: center;">
            <div style="width: 48px; height: 48px; margin: 0 auto 1.5rem; background: #000000; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#aeef00" stroke-width="2">
                <rect x="3" y="8" width="18" height="12" rx="2"/>
                <path d="M3 10a2 2 0 012-2h14a2 2 0 012 2M7 14h.01M11 14h.01"/>
              </svg>
            </div>
            <h3 class="h3" style="margin-bottom: 0.5rem; color: #000000; font-size: 1.6rem; font-weight: 600;">LIMITED APPAREL.</h3>
            <p style="font-size: 1.4rem; color: #666666;">No restocks, truly limited edition.</p>
          </div>
          <div style="text-align: center;">
            <div style="width: 48px; height: 48px; margin: 0 auto 1.5rem; background: #000000; border-radius: 4px; display: flex; align-items: center; justify-content: center;">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#aeef00" stroke-width="2">
                <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                <path d="M16 21V5a2 2 0 00-2-2h-4a2 2 0 00-2 2v16"/>
              </svg>
            </div>
            <h3 class="h3" style="margin-bottom: 0.5rem; color: #000000; font-size: 1.6rem; font-weight: 600;">100% PAYMENT SECURE.</h3>
            <p style="font-size: 1.4rem; color: #666666;">Shop with confidence.</p>
          </div>
        </div>
      </div>
    </section>


    <!-- Hooks -->
    {% if section.settings.show_hooks %}
    <section class="mcst-section mcst-hooks">
      <h2 class="h1">Hooks</h2>
      <p class="rte" style="margin-top: 1rem; font-size: 1.6rem;">Conversation starters for when you're talking to these organizations. Not scripts, just real talk.</p>
      <div class="accordion" style="margin-top: 2rem;">
        <details>
          <summary>
            <h3 class="accordion__title h4">Big Shoulders Fund</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They're putting money directly into Chicago schools that need it most. No bureaucracy, no middlemen. Just results. That's the kind of partner we want.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Thrive Chicago</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They're connecting young people to real opportunities. Not just programs, but pathways. That's what we're about too.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Dreams for Kids</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>Adaptive sports, real inclusion, real impact. They're showing what's possible when you don't make excuses.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Special Children's Charities</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They've been doing this for decades. Real experience, real relationships, real results. That's who we want to learn from.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">StreetWise</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They're giving people jobs, not just handouts. Economic empowerment, not charity. That's the model.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Greater Chicago Food Depository</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They're feeding people. No politics, no BS. Just food on tables. That's impact we can get behind.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Chicago Cares</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They're mobilizing volunteers for real work. Not photo ops, actual change. That's what we need.</p>
          </div>
        </details>
      </div>
      <p class="mcst-hooks__note">Conversation starters, not scripts.</p>
    </section>
    {% endif %}

    <!-- The Exchange -->
    <section id="mcst-exchange-{{ section.id }}" class="mcst-section" style="background: #282828;">
      <div class="page-width">
        <h2 class="h1" style="text-align: center;">WE NEED YOUR BOOTS ON THE GROUND.</h2>
        <div class="rte" style="margin-top: 2rem; font-size: 1.8rem; max-width: 80rem; margin-left: auto; margin-right: auto; line-height: 1.8; text-align: center;">
          <p>We aren't a boardroom making guesses. We're a neighbor with a vision. We are spending 2026 vetting local partners—from the Greater Chicago Food Depository to StreetWise—to ensure our impact is real.</p>
          <p style="margin-top: 2rem;"><strong>The Ask:</strong> Tell us who is doing the work in your neighborhood. Help us stay authentic. Help us stay local.</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    {% if section.settings.show_faq %}
    <section class="mcst-section mcst-faq">
      <h2 class="h1">FAQ</h2>
      <div class="accordion" style="margin-top: 2rem;">
        <details>
          <summary>
            <h3 class="accordion__title h4">Is this a nonprofit?</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>No. We're a social enterprise. That means we can move fast, make real decisions, and put money where it matters without the red tape. We're building a brand that gives back, not one that just talks about it.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">When do I get my stuff?</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>We're in foundational growth phase. We're building the right way, not the fast way. You'll get updates, early access when we launch, and founder pricing locked in. But we're being honest about the timeline.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">What's the actual impact?</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>Every purchase supports Chicago neighborhoods. We're vetting partners now, and when we launch, the impact starts. We'll show you exactly where the money goes. No smoke, no mirrors, just real results.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Why should I join now?</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>Founder pricing, early access, and a voice in what we build. This is for the people who believed first. The prices won't be this good again, and the access won't be this direct.</p>
          </div>
        </details>
      </div>
    </section>
    {% endif %}

    <!-- Signup -->
    <section id="mcst-signup-{{ section.id }}" class="mcst-section mcst-signup">
      <h2 class="h1" style="text-align: center;">BECOME A FOUNDING MEMBER.</h2>
      <p style="text-align: center; margin-top: 1rem; font-size: 1.8rem; max-width: 80rem; margin-left: auto; margin-right: auto; line-height: 1.6;">We are taking off slowly in 2026 to ensure the quality and the mission are perfect. Join the Founders Circle to get first access to our "Neighborhood Drops" and a direct voice in which local charities we support first.</p>

      {% form 'customer', class: 'mcst-signup-form' %}
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="founders_circle">
        <input type="hidden" name="contact[context]" value="mcst_coming_soon_{{ section.id }}">

        {%- if form.errors -%}
          <div class="form__message" style="margin-bottom: 2rem; padding: 1rem; background: rgba(255, 0, 0, 0.1); border: 1px solid #ff0000; border-radius: 4px; color: #ffffff;">
            <h2 tabindex="-1" autofocus>
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
            <ul style="margin-top: 1rem; padding-left: 2rem;">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#mcst-{{ field }}-{{ section.id }}">
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="email"
            id="mcst-email-{{ section.id }}"
            name="contact[email]"
            class="field__input"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            required
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="Enter your email address..."
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="mcst-email-error-{{ section.id }}"
            {% endif %}
          >
          <label class="field__label" for="mcst-email-{{ section.id }}">
            Email address <span aria-hidden="true">*</span>
          </label>
          {%- if form.errors contains 'email' -%}
            <small class="form__message" id="mcst-email-error-{{ section.id }}" style="display: block; margin-top: 0.5rem; color: #ff0000;">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              {% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
            </small>
          {%- endif -%}
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-first-name-{{ section.id }}"
            name="contact[first_name]"
            class="field__input"
            value="{% if form.first_name %}{{ form.first_name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
            autocomplete="given-name"
            placeholder="First name"
          >
          <label class="field__label" for="mcst-first-name-{{ section.id }}">
            First name
          </label>
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-organization-{{ section.id }}"
            name="contact[organization]"
            class="field__input"
            value="{% if form.organization %}{{ form.organization }}{% endif %}"
            placeholder="Organization"
          >
          <label class="field__label" for="mcst-organization-{{ section.id }}">
            Organization
          </label>
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-role-{{ section.id }}"
            name="contact[role]"
            class="field__input"
            value="{% if form.role %}{{ form.role }}{% endif %}"
            placeholder="Role"
          >
          <label class="field__label" for="mcst-role-{{ section.id }}">
            Role
          </label>
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-neighborhood-{{ section.id }}"
            name="contact[neighborhood]"
            class="field__input"
            value="{% if form.neighborhood %}{{ form.neighborhood }}{% endif %}"
            placeholder="Neighborhood"
          >
          <label class="field__label" for="mcst-neighborhood-{{ section.id }}">
            Neighborhood
          </label>
        </div>

        <div style="text-align: center;">
          <button type="submit" class="button button--primary button--full-width" name="commit" style="background-color: #000000; color: #ffffff; border: 2px solid #000000; padding: 1.5rem 3rem; font-size: 1.4rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em;">
            JOIN THE FOUNDERS CIRCLE
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <div class="form__message" style="margin-top: 2rem; padding: 1.5rem; background: rgba(174, 239, 0, 0.1); border: 1px solid #aeef00; border-radius: 4px; text-align: center; color: #ffffff;" tabindex="-1" autofocus>
            {% render 'icon-success' %}
            <span style="margin-left: 0.5rem;">Thank you! You've been added to the Founder's Circle. Check your email for confirmation.</span>
          </div>
        {%- endif -%}
      {% endform %}

      <p class="mcst-signup__privacy" style="text-align: center; margin-top: 2rem; font-size: 1.4rem; opacity: 0.8;">No spam. Just city pride and local progress.</p>
    </section>

    <!-- Footer -->
    <footer class="mcst-footer" style="background: #000000; padding: 6rem 0 4rem; margin-top: 6rem;">
      <div class="page-width">
        <div style="text-align: center; margin-bottom: 4rem;">
          <p class="rte" style="font-size: 2rem; font-weight: 600; margin-bottom: 3rem;">
            Because Chicago stands taller when we stand together.
          </p>
          <nav style="display: flex; justify-content: center; gap: 3rem; flex-wrap: wrap; margin-bottom: 3rem;">
            <a href="#mcst-support-{{ section.id }}" style="color: #ffffff; text-decoration: none; font-size: 1.4rem; text-transform: uppercase; letter-spacing: 0.05em;">Support</a>
            <a href="#mcst-company-{{ section.id }}" style="color: #ffffff; text-decoration: none; font-size: 1.4rem; text-transform: uppercase; letter-spacing: 0.05em;">Company Info</a>
            <a href="/account" style="color: #ffffff; text-decoration: none; font-size: 1.4rem; text-transform: uppercase; letter-spacing: 0.05em;">My Account</a>
            <a href="/pages/contact" style="color: #ffffff; text-decoration: none; font-size: 1.4rem; text-transform: uppercase; letter-spacing: 0.05em;">Contact Us</a>
          </nav>
          <div style="display: flex; justify-content: center; gap: 2rem; margin-bottom: 3rem;">
            {% if settings.social_instagram_link != blank %}
              <a href="{{ settings.social_instagram_link }}" target="_blank" rel="noopener" style="color: #ffffff; text-decoration: none; font-size: 2rem;">Instagram</a>
            {% endif %}
            {% if settings.social_tiktok_link != blank %}
              <a href="{{ settings.social_tiktok_link }}" target="_blank" rel="noopener" style="color: #ffffff; text-decoration: none; font-size: 2rem;">TikTok</a>
            {% endif %}
            {% if settings.social_facebook_link != blank %}
              <a href="{{ settings.social_facebook_link }}" target="_blank" rel="noopener" style="color: #ffffff; text-decoration: none; font-size: 2rem;">Facebook</a>
            {% endif %}
          </div>
        </div>
        <div style="text-align: center; padding-top: 3rem; border-top: 1px solid rgba(255, 255, 255, 0.1);">
          <p style="font-size: 1.2rem; opacity: 0.7;">
            &copy; {{ 'now' | date: '%Y' }} My City Stands Together. All Rights Reserved.
          </p>
        </div>
      </div>
    </footer>
  </div>
</div>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const section = document.getElementById('mcst-coming-soon-' + sectionId);
  if (!section) return;

  // Smooth scroll to signup
  const scrollButtons = section.querySelectorAll('.mcst-scroll-to-signup');
  scrollButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const signup = section.querySelector('#mcst-signup-' + sectionId);
      if (signup) {
        signup.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // Interactive scroll section for "The Why"
  const whyScrollSection = section.querySelector('.mcst-why-scroll');
  if (whyScrollSection) {
    const slides = whyScrollSection.querySelectorAll('.mcst-why-slide');
    let currentSlide = 0;
    
    const updateSlide = () => {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
      const sectionTop = whyScrollSection.offsetTop;
      const sectionHeight = whyScrollSection.offsetHeight;
      const viewportHeight = window.innerHeight;
      
      const scrollProgress = Math.max(0, Math.min(1, (scrollTop - sectionTop + viewportHeight) / sectionHeight));
      const slideIndex = Math.min(Math.floor(scrollProgress * slides.length), slides.length - 1);
      
      if (slideIndex !== currentSlide) {
        slides[currentSlide].style.opacity = '0';
        currentSlide = slideIndex;
        slides[currentSlide].style.opacity = '1';
      }
    };
    
    // Set first slide visible
    if (slides.length > 0) {
      slides[0].style.opacity = '1';
    }
    
    window.addEventListener('scroll', updateSlide);
    updateSlide();
  }

  // IntersectionObserver for section reveals
  const sections = section.querySelectorAll('.mcst-section');
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);

  sections.forEach(sec => {
    observer.observe(sec);
  });

  // Form validation
  const form = section.querySelector('.mcst-signup-form');
  if (form) {
    const emailInput = form.querySelector('#mcst-email-' + sectionId);
    form.addEventListener('submit', function(e) {
      if (!emailInput.value.trim()) {
        e.preventDefault();
        emailInput.focus();
        emailInput.setAttribute('aria-invalid', 'true');
        let errorMsg = emailInput.parentElement.querySelector('.field-error');
        if (!errorMsg) {
          errorMsg = document.createElement('small');
          errorMsg.className = 'form__message field-error';
          errorMsg.style.cssText = 'display: block; margin-top: 0.5rem; color: rgb(var(--error-color));';
          errorMsg.textContent = 'Email is required';
          emailInput.parentElement.appendChild(errorMsg);
        }
        return false;
      }
    });
  }
})();
</script>

{% schema %}
{
  "name": "MCST Founders Circle",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero Section"
    },
    {
      "type": "image_picker",
      "id": "hero_background_image",
      "label": "Hero Background Image",
      "info": "Full-width background image for hero section (recommended: 2000x1200px)"
    },
    {
      "type": "header",
      "content": "Section Visibility"
    },
    {
      "type": "checkbox",
      "id": "show_hooks",
      "label": "Show Hooks Section",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_faq",
      "label": "Show FAQ Section",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "MCST Founders Circle"
    }
  ]
}
{% endschema %}

