{%- style -%}
  #mcst-coming-soon-{{ section.id }} {
    position: relative;
    min-height: 100vh;
    background: rgb(var(--color-background));
  }

  #mcst-coming-soon-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: url("data:image/svg+xml,%3Csvg width='100' height='100' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3Cpattern id='chicago-flag' x='0' y='0' width='100' height='100' patternUnits='userSpaceOnUse'%3E%3Crect width='100' height='100' fill='%23ffffff' opacity='0.02'/%3E%3Crect y='0' width='100' height='33.33' fill='%23000000' opacity='0.02'/%3E%3Crect y='66.66' width='100' height='33.33' fill='%23000000' opacity='0.02'/%3E%3Ccircle cx='50' cy='50' r='8' fill='%23FF0000' opacity='0.03'/%3E%3C/pattern%3E%3C/defs%3E%3Crect width='100' height='100' fill='url(%23chicago-flag)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    opacity: 0.3;
    pointer-events: none;
    z-index: 0;
  }

  #mcst-coming-soon-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(0,0,0,0.03) 2px, rgba(0,0,0,0.03) 4px);
    pointer-events: none;
    z-index: 0;
  }

  #mcst-coming-soon-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-sticky-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(var(--color-background), 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
    padding: 1.5rem 0;
    transition: all 0.3s ease;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-sticky-header__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: var(--container-max-width, 1200px);
    margin: 0 auto;
    padding: 0 var(--container-distance, 2rem);
  }

  #mcst-coming-soon-{{ section.id }} .mcst-sticky-header__logo {
    font-size: 1.8rem;
    font-weight: var(--text-font-bold-weight, 700);
    color: rgb(var(--color-foreground));
    text-decoration: none;
    letter-spacing: 0.05em;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-sticky-header__badge {
    font-size: 1rem;
    opacity: 0.7;
    margin-left: 1rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero {
    padding: 8rem 0 6rem;
    text-align: center;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hero__rotating-text {
    margin-top: 2rem;
    font-size: 1.4rem;
    opacity: 0.8;
    min-height: 2.5rem;
    transition: opacity 0.3s ease;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-section {
    padding: 6rem 0;
    opacity: 0;
    transform: translateY(20px);
    transition: opacity 0.6s ease, transform 0.6s ease;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-section.visible {
    opacity: 1;
    transform: translateY(0);
  }

  #mcst-coming-soon-{{ section.id }} .mcst-value-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
    margin-top: 3rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-value-card {
    padding: 2rem;
    background: rgba(var(--color-foreground), 0.03);
    border-radius: var(--block-border-radius, 8px);
    border: 1px solid rgba(var(--color-foreground), 0.1);
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hooks {
    margin-top: 3rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-hooks__note {
    font-size: 1.2rem;
    opacity: 0.7;
    margin-top: 1rem;
    font-style: italic;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 4rem;
    margin-top: 3rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange__column h3 {
    margin-bottom: 1.5rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange__column ul {
    list-style: none;
    padding: 0;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange__column li {
    padding: 0.8rem 0;
    border-bottom: 1px solid rgba(var(--color-foreground), 0.1);
  }

  #mcst-coming-soon-{{ section.id }} .mcst-exchange__column li:last-child {
    border-bottom: none;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-faq {
    margin-top: 3rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-signup {
    background: rgba(var(--color-foreground), 0.05);
    padding: 4rem 2rem;
    border-radius: var(--block-border-radius, 8px);
    margin-top: 4rem;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-signup__privacy {
    font-size: 1.2rem;
    opacity: 0.7;
    margin-top: 1rem;
    text-align: center;
  }

  #mcst-coming-soon-{{ section.id }} .mcst-footer {
    text-align: center;
    padding: 4rem 0;
    border-top: 1px solid rgba(var(--color-foreground), 0.1);
    margin-top: 6rem;
  }

  @media screen and (max-width: 749px) {
    #mcst-coming-soon-{{ section.id }} .mcst-sticky-header__inner {
      flex-direction: column;
      gap: 1rem;
      text-align: center;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-sticky-header__badge {
      margin-left: 0;
      margin-top: 0.5rem;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-hero {
      padding: 4rem 0 3rem;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-section {
      padding: 4rem 0;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-exchange {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    #mcst-coming-soon-{{ section.id }} .mcst-value-cards {
      grid-template-columns: 1fr;
    }
  }
{%- endstyle -%}

<div id="mcst-coming-soon-{{ section.id }}">
  <!-- Sticky Header -->
  <div class="mcst-sticky-header">
    <div class="mcst-sticky-header__inner">
      <div>
        <div class="mcst-sticky-header__logo">MyCityStandsTogether</div>
        <div class="mcst-sticky-header__badge">Updated January 2026, Foundational Growth Phase</div>
      </div>
      <a href="#mcst-signup-{{ section.id }}" class="button button--primary mcst-scroll-to-signup">
        Join the Founder's Circle
      </a>
    </div>
  </div>

  <div class="page-width">
    <!-- Hero -->
    <section class="mcst-hero mcst-section">
      <h1 class="h0">{{ section.settings.hero_headline | default: "Join the Founder's Circle" }}</h1>
      <div class="rte" style="margin-top: 2rem; font-size: 1.6rem; max-width: 70rem; margin-left: auto; margin-right: auto;">
        {{ section.settings.hero_subhead | default: "<p>Slow build, real Chicago, foundation first. We're not rushing this. We're building something that matters, for the people who matter.</p>" }}
      </div>
      <div style="margin-top: 3rem;">
        <a href="#mcst-signup-{{ section.id }}" class="button button--primary mcst-scroll-to-signup">
          Join the Founder's Circle
        </a>
      </div>
      <div style="margin-top: 2rem;">
        <a href="#mcst-why-{{ section.id }}" class="button button--secondary" style="text-decoration: none;">
          Why we exist
        </a>
      </div>
      <div class="mcst-hero__rotating-text" id="mcst-rotating-text-{{ section.id }}">
        Chicago pride, Chicago progress
      </div>
    </section>

    <!-- The Why -->
    <section id="mcst-why-{{ section.id }}" class="mcst-section">
      <h2 class="h1">The Why</h2>
      <div class="rte" style="margin-top: 2rem; font-size: 1.6rem; line-height: 1.8;">
        <p><strong>Big brands sell Chicago, neighborhoods get scraps.</strong></p>
        <p style="margin-top: 1.5rem;">We're a social enterprise, not a 501(c)(3). That means we can move fast, make real decisions, and put money where it matters. We're building a brand that gives back, not one that just talks about it.</p>
        <p style="margin-top: 1.5rem;">Every purchase supports Chicago neighborhoods. Every partnership is vetted. Every dollar has intention.</p>
      </div>
    </section>

    <!-- What is the Founder's Circle -->
    <section class="mcst-section">
      <h2 class="h1">What is the Founder's Circle</h2>
      <div class="mcst-value-cards">
        <div class="mcst-value-card">
          <h3 class="h3">Early Access</h3>
          <p>First dibs on drops, exclusive designs, and founder pricing that won't come around again.</p>
        </div>
        <div class="mcst-value-card">
          <h3 class="h3">Direct Impact</h3>
          <p>See exactly where your support goes. Real updates, real stories, real change in Chicago neighborhoods.</p>
        </div>
        <div class="mcst-value-card">
          <h3 class="h3">Founder Pricing</h3>
          <p>Lock in the best prices we'll ever offer. This is for the people who believed first.</p>
        </div>
        <div class="mcst-value-card">
          <h3 class="h3">Community</h3>
          <p>Connect with other founders who get it. This is about building something together.</p>
        </div>
        <div class="mcst-value-card">
          <h3 class="h3">Voice</h3>
          <p>Your input shapes what we build. We listen, we adapt, we build what you actually want.</p>
        </div>
      </div>
      <div class="rte" style="margin-top: 3rem; padding: 2rem; background: rgba(var(--color-foreground), 0.05); border-radius: var(--block-border-radius, 8px);">
        <p><strong>Real talk:</strong> We're not writing five-figure checks today. The intention is baked in, we're vetting partners now, and when we launch, the impact starts. But we're being honest about where we are. Foundation first.</p>
      </div>
    </section>

    <!-- Hooks -->
    {% if section.settings.show_hooks %}
    <section class="mcst-section mcst-hooks">
      <h2 class="h1">Hooks</h2>
      <p class="rte" style="margin-top: 1rem; font-size: 1.6rem;">Conversation starters for when you're talking to these organizations. Not scripts, just real talk.</p>
      <div class="accordion" style="margin-top: 2rem;">
        <details>
          <summary>
            <h3 class="accordion__title h4">Big Shoulders Fund</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They're putting money directly into Chicago schools that need it most. No bureaucracy, no middlemen. Just results. That's the kind of partner we want.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Thrive Chicago</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They're connecting young people to real opportunities. Not just programs, but pathways. That's what we're about too.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Dreams for Kids</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>Adaptive sports, real inclusion, real impact. They're showing what's possible when you don't make excuses.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Special Children's Charities</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They've been doing this for decades. Real experience, real relationships, real results. That's who we want to learn from.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">StreetWise</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They're giving people jobs, not just handouts. Economic empowerment, not charity. That's the model.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Greater Chicago Food Depository</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They're feeding people. No politics, no BS. Just food on tables. That's impact we can get behind.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Chicago Cares</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>They're mobilizing volunteers for real work. Not photo ops, actual change. That's what we need.</p>
          </div>
        </details>
      </div>
      <p class="mcst-hooks__note">Conversation starters, not scripts.</p>
    </section>
    {% endif %}

    <!-- Exchange -->
    <section class="mcst-section">
      <h2 class="h1">The Exchange</h2>
      <div class="mcst-exchange">
        <div class="mcst-exchange__column">
          <h3 class="h3">How we help you</h3>
          <ul>
            <li>Premium streetwear that actually represents Chicago</li>
            <li>Founder pricing locked in for life</li>
            <li>Early access to every drop</li>
            <li>Exclusive designs you won't find anywhere else</li>
            <li>Direct line to the team, your feedback matters</li>
            <li>See your impact in real time</li>
          </ul>
        </div>
        <div class="mcst-exchange__column">
          <h3 class="h3">What we ask of you</h3>
          <ul>
            <li>Join early, believe in the mission</li>
            <li>Share with people who get it</li>
            <li>Give honest feedback, help us build</li>
            <li>Wear it, represent the city</li>
            <li>Be part of something bigger</li>
            <li>Stay committed to Chicago</li>
          </ul>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    {% if section.settings.show_faq %}
    <section class="mcst-section mcst-faq">
      <h2 class="h1">FAQ</h2>
      <div class="accordion" style="margin-top: 2rem;">
        <details>
          <summary>
            <h3 class="accordion__title h4">Is this a nonprofit?</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>No. We're a social enterprise. That means we can move fast, make real decisions, and put money where it matters without the red tape. We're building a brand that gives back, not one that just talks about it.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">When do I get my stuff?</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>We're in foundational growth phase. We're building the right way, not the fast way. You'll get updates, early access when we launch, and founder pricing locked in. But we're being honest about the timeline.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">What's the actual impact?</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>Every purchase supports Chicago neighborhoods. We're vetting partners now, and when we launch, the impact starts. We'll show you exactly where the money goes. No smoke, no mirrors, just real results.</p>
          </div>
        </details>
        <details>
          <summary>
            <h3 class="accordion__title h4">Why should I join now?</h3>
            {% render 'icon-caret' %}
          </summary>
          <div class="accordion__content rte">
            <p>Founder pricing, early access, and a voice in what we build. This is for the people who believed first. The prices won't be this good again, and the access won't be this direct.</p>
          </div>
        </details>
      </div>
    </section>
    {% endif %}

    <!-- Signup -->
    <section id="mcst-signup-{{ section.id }}" class="mcst-section mcst-signup">
      <h2 class="h1" style="text-align: center;">Join the Founder's Circle</h2>
      <p style="text-align: center; margin-top: 1rem; font-size: 1.6rem; opacity: 0.8;">Get early access, founder pricing, and direct impact updates.</p>

      {% form 'customer', class: 'mcst-signup-form' %}
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="founders_circle">
        <input type="hidden" name="contact[context]" value="mcst_coming_soon_{{ section.id }}">

        {%- if form.errors -%}
          <div class="form__message" style="margin-bottom: 2rem; padding: 1rem; background: rgba(var(--error-background), 0.1); border: 1px solid rgb(var(--error-color)); border-radius: 4px;">
            <h2 tabindex="-1" autofocus>
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              {{ 'templates.contact.form.error_heading' | t }}
            </h2>
            <ul style="margin-top: 1rem; padding-left: 2rem;">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#mcst-{{ field }}-{{ section.id }}">
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="email"
            id="mcst-email-{{ section.id }}"
            name="contact[email]"
            class="field__input"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            required
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="Email address *"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="mcst-email-error-{{ section.id }}"
            {% endif %}
          >
          <label class="field__label" for="mcst-email-{{ section.id }}">
            Email address <span aria-hidden="true">*</span>
          </label>
          {%- if form.errors contains 'email' -%}
            <small class="form__message" id="mcst-email-error-{{ section.id }}" style="display: block; margin-top: 0.5rem; color: rgb(var(--error-color));">
              <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
              {% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
            </small>
          {%- endif -%}
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-first-name-{{ section.id }}"
            name="contact[first_name]"
            class="field__input"
            value="{% if form.first_name %}{{ form.first_name }}{% elsif customer %}{{ customer.first_name }}{% endif %}"
            autocomplete="given-name"
            placeholder="First name"
          >
          <label class="field__label" for="mcst-first-name-{{ section.id }}">
            First name
          </label>
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-organization-{{ section.id }}"
            name="contact[organization]"
            class="field__input"
            value="{% if form.organization %}{{ form.organization }}{% endif %}"
            placeholder="Organization"
          >
          <label class="field__label" for="mcst-organization-{{ section.id }}">
            Organization
          </label>
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-role-{{ section.id }}"
            name="contact[role]"
            class="field__input"
            value="{% if form.role %}{{ form.role }}{% endif %}"
            placeholder="Role"
          >
          <label class="field__label" for="mcst-role-{{ section.id }}">
            Role
          </label>
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-neighborhood-{{ section.id }}"
            name="contact[neighborhood]"
            class="field__input"
            value="{% if form.neighborhood %}{{ form.neighborhood }}{% endif %}"
            placeholder="Neighborhood"
          >
          <label class="field__label" for="mcst-neighborhood-{{ section.id }}">
            Neighborhood
          </label>
        </div>

        <div style="text-align: center;">
          <button type="submit" class="button button--primary button--full-width" name="commit">
            Join the Founder's Circle
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <div class="form__message" style="margin-top: 2rem; padding: 1.5rem; background: rgba(var(--success-background), 0.1); border: 1px solid rgb(var(--success-color)); border-radius: 4px; text-align: center;" tabindex="-1" autofocus>
            {% render 'icon-success' %}
            <span style="margin-left: 0.5rem;">Thank you! You've been added to the Founder's Circle. Check your email for confirmation.</span>
          </div>
        {%- endif -%}
      {% endform %}

      <p class="mcst-signup__privacy">No spam, no selling your info, ever.</p>
    </section>

    <!-- Footer -->
    <footer class="mcst-footer">
      <p class="rte" style="font-size: 1.6rem; margin-bottom: 1rem;">
        <strong>Mission:</strong> Build premium streetwear that represents Chicago, support neighborhoods that built it, and create a brand that gives back, not just talks about it.
      </p>
      <p style="font-size: 1.4rem; opacity: 0.7; margin-top: 2rem;">
        Built in Chicago, built to last
      </p>
      <p style="font-size: 1.2rem; opacity: 0.6; margin-top: 1rem;">
        &copy; {{ 'now' | date: '%Y' }} MyCityStandsTogether. All rights reserved.
      </p>
    </footer>
  </div>
</div>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const section = document.getElementById('mcst-coming-soon-' + sectionId);
  if (!section) return;

  // Smooth scroll to signup
  const scrollButtons = section.querySelectorAll('.mcst-scroll-to-signup');
  scrollButtons.forEach(button => {
    button.addEventListener('click', function(e) {
      e.preventDefault();
      const signup = section.querySelector('#mcst-signup-' + sectionId);
      if (signup) {
        signup.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // Rotating text
  const rotatingTexts = [
    'Chicago pride, Chicago progress',
    'Built slow, built real',
    'Not for tourists, for us',
    'Wear the city, support the block'
  ];
  const rotatingTextEl = section.querySelector('#mcst-rotating-text-' + sectionId);
  if (rotatingTextEl) {
    let currentIndex = 0;
    setInterval(() => {
      rotatingTextEl.style.opacity = '0';
      setTimeout(() => {
        currentIndex = (currentIndex + 1) % rotatingTexts.length;
        rotatingTextEl.textContent = rotatingTexts[currentIndex];
        rotatingTextEl.style.opacity = '0.8';
      }, 300);
    }, 4000);
  }

  // IntersectionObserver for section reveals
  const sections = section.querySelectorAll('.mcst-section');
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.classList.add('visible');
      }
    });
  }, observerOptions);

  sections.forEach(sec => {
    observer.observe(sec);
  });

  // Form validation
  const form = section.querySelector('.mcst-signup-form');
  if (form) {
    const emailInput = form.querySelector('#mcst-email-' + sectionId);
    form.addEventListener('submit', function(e) {
      if (!emailInput.value.trim()) {
        e.preventDefault();
        emailInput.focus();
        emailInput.setAttribute('aria-invalid', 'true');
        let errorMsg = emailInput.parentElement.querySelector('.field-error');
        if (!errorMsg) {
          errorMsg = document.createElement('small');
          errorMsg.className = 'form__message field-error';
          errorMsg.style.cssText = 'display: block; margin-top: 0.5rem; color: rgb(var(--error-color));';
          errorMsg.textContent = 'Email is required';
          emailInput.parentElement.appendChild(errorMsg);
        }
        return false;
      }
    });
  }
})();
</script>

