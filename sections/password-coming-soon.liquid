{%- style -%}
  #password-coming-soon-{{ section.id }} {
    min-height: 80vh;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0a0a0a 100%);
    color: #ffffff;
    padding: 4rem 2rem;
    text-align: center;
    position: relative;
    overflow: hidden;
  }

  #password-coming-soon-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: radial-gradient(circle at 20% 50%, rgba(174, 239, 0, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  #password-coming-soon-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  #password-coming-soon-{{ section.id }} .password-content {
    max-width: 600px;
    width: 100%;
  }

  #password-coming-soon-{{ section.id }} .password-logo {
    font-size: 3rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: #aeef00;
    margin-bottom: 2rem;
    text-transform: uppercase;
  }

  #password-coming-soon-{{ section.id }} .password-heading {
    font-size: 3.5rem;
    font-weight: 700;
    line-height: 1.2;
    margin-bottom: 1.5rem;
    color: #ffffff;
  }

  #password-coming-soon-{{ section.id }} .password-description {
    font-size: 1.6rem;
    line-height: 1.6;
    margin-bottom: 3rem;
    color: rgba(255, 255, 255, 0.8);
  }

  #password-coming-soon-{{ section.id }} .password-form-wrapper {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
    padding: 3rem 2rem;
    margin-top: 2rem;
  }

  #password-coming-soon-{{ section.id }} .password-form-heading {
    font-size: 2rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #aeef00;
  }

  #password-coming-soon-{{ section.id }} .password-form-description {
    font-size: 1.4rem;
    margin-bottom: 2rem;
    color: rgba(255, 255, 255, 0.7);
  }

  #password-coming-soon-{{ section.id }} .password-form {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  #password-coming-soon-{{ section.id }} .password-field {
    width: 100%;
  }

  #password-coming-soon-{{ section.id }} .password-input {
    width: 100%;
    padding: 1.5rem 2rem;
    font-size: 1.6rem;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: #ffffff;
    transition: all 0.3s ease;
  }

  #password-coming-soon-{{ section.id }} .password-input:focus {
    outline: none;
    border-color: #aeef00;
    background: rgba(255, 255, 255, 0.15);
  }

  #password-coming-soon-{{ section.id }} .password-input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  #password-coming-soon-{{ section.id }} .password-button {
    width: 100%;
    padding: 1.5rem 3rem;
    font-size: 1.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: #aeef00;
    color: #000000;
    border: 2px solid #aeef00;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  #password-coming-soon-{{ section.id }} .password-button:hover {
    background: #ffffff;
    border-color: #ffffff;
    transform: translateY(-2px);
  }

  #password-coming-soon-{{ section.id }} .password-message {
    padding: 1.5rem;
    border-radius: 8px;
    margin-top: 1.5rem;
    font-size: 1.4rem;
  }

  #password-coming-soon-{{ section.id }} .password-message--success {
    background: rgba(174, 239, 0, 0.2);
    border: 1px solid #aeef00;
    color: #aeef00;
  }

  #password-coming-soon-{{ section.id }} .password-message--error {
    background: rgba(255, 0, 0, 0.2);
    border: 1px solid #ff0000;
    color: #ff6b6b;
  }

  @media screen and (min-width: 750px) {
    #password-coming-soon-{{ section.id }} .password-form {
      flex-direction: row;
    }

    #password-coming-soon-{{ section.id }} .password-button {
      width: auto;
      min-width: 200px;
    }
  }

  @media screen and (max-width: 749px) {
    #password-coming-soon-{{ section.id }} {
      padding: 3rem 1.5rem;
    }

    #password-coming-soon-{{ section.id }} .password-logo {
      font-size: 2rem;
    }

    #password-coming-soon-{{ section.id }} .password-heading {
      font-size: 2.5rem;
    }

    #password-coming-soon-{{ section.id }} .password-description {
      font-size: 1.4rem;
    }
  }
{%- endstyle -%}

<div id="password-coming-soon-{{ section.id }}">
  <div class="password-content">
    <div class="password-logo">
      {% if section.settings.logo_text != blank %}
        {{ section.settings.logo_text }}
      {% else %}
        MyCityStandsTogether
      {% endif %}
    </div>

    <h1 class="password-heading">
      {% if section.settings.heading != blank %}
        {{ section.settings.heading }}
      {% else %}
        Something Big is Coming
      {% endif %}
    </h1>

    {% if section.settings.description != blank %}
      <div class="password-description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <div class="password-form-wrapper">
      <h2 class="password-form-heading">
        {% if section.settings.form_heading != blank %}
          {{ section.settings.form_heading }}
        {% else %}
          Join the Founders Circle
        {% endif %}
      </h2>

      {% if section.settings.form_description != blank %}
        <p class="password-form-description">
          {{ section.settings.form_description }}
        </p>
      {% endif %}

      {% form 'customer', class: 'password-signup-form' %}
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="founders_circle,password_page">

        {% if form.errors %}
          <div class="password-message password-message--error" role="alert">
            <strong>Error:</strong>
            {% for field in form.errors %}
              {{ form.errors[field] }}
            {% endfor %}
          </div>
        {% endif %}

        <div class="password-form">
          <div class="password-field">
            <input
              type="email"
              name="contact[email]"
              class="password-input"
              placeholder="{% if section.settings.email_placeholder != blank %}{{ section.settings.email_placeholder }}{% else %}Enter your email address{% endif %}"
              required
              aria-required="true"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            >
          </div>
          <button type="submit" class="password-button" name="commit">
            {% if section.settings.button_text != blank %}
              {{ section.settings.button_text }}
            {% else %}
              Join Now
            {% endif %}
          </button>
        </div>

        {% if form.posted_successfully? %}
          <div class="password-message password-message--success" role="status">
            {% if section.settings.success_message != blank %}
              {{ section.settings.success_message }}
            {% else %}
              Thank you! You've been added to the Founders Circle.
            {% endif %}
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password Coming Soon",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "logo_text",
      "label": "Logo Text",
      "default": "MyCityStandsTogether"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something Big is Coming"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>We're building something special. Join the Founders Circle to be the first to know when we launch.</p>"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Join the Founders Circle"
    },
    {
      "type": "text",
      "id": "form_description",
      "label": "Form Description",
      "default": "Get exclusive access and early updates"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Join Now"
    },
    {
      "type": "richtext",
      "id": "success_message",
      "label": "Success Message",
      "default": "<p>Thank you! You've been added to the Founders Circle. Check your email for confirmation.</p>"
    }
  ],
  "presets": [
    {
      "name": "Password Coming Soon"
    }
  ]
}
{% endschema %}
