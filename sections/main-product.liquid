  /* FIX: prevent image and options from overlapping on mid sizes */
  @media screen and (max-width: 950px) {
    .main-product {
      display: block !important;          /* no side by side layout */
    }

    .main-product > * {
      width: 100% !important;
      max-width: 100% !important;
    }

    /* media on top, info below */
    .main-product ap-productmedia,
    .main-product .ap-productmedia {
      margin-bottom: 24px;
    }

    /* disable sticky behavior on small widths */
    .main-product .product__info,
    .main-product .ap-productmeta {
      position: static !important;
      top: auto !important;
    }
  }

  /* Urgency Counters Styles */
  .product-urgency-counters {
    margin: 1.5rem 0;
    padding: 1rem;
    background: rgba(0, 0, 0, 0.03);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .urgency-counter {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.9rem;
  }

  .urgency-counter__emoji {
    font-size: 1.5rem;
    line-height: 1;
  }

  .urgency-counter__text {
    display: flex;
    align-items: baseline;
    gap: 0.25rem;
    flex-wrap: wrap;
  }

  .urgency-counter__number {
    font-weight: 700;
    font-size: 1.1rem;
    color: #d32f2f;
    transition: all 0.3s ease;
  }

  .urgency-counter--cart .urgency-counter__number {
    color: #f57c00;
  }

  .urgency-counter__label {
    color: #666;
    font-size: 0.85rem;
  }

  @media screen and (min-width: 750px) {
    .product-urgency-counters {
      flex-direction: row;
      justify-content: space-between;
      gap: 1.5rem;
    }
  }
  
</style>
<script>
  try {
    const items = JSON.parse(localStorage.getItem('theme:ap-recentlyproductsviewed') || '[]');
    if (!items.includes({{ product.id }})) {
      items.unshift({{ product.id }});
    }
    localStorage.setItem('theme:ap-recentlyproductsviewed', JSON.stringify(items.slice(0, 20)));
  } catch (e) {
    // have error
  }
</script>
<script>
  // Urgency Counters - Realistic counter simulation
  (function() {
    const countersContainer = document.querySelector('.product-urgency-counters');
    if (!countersContainer) return;

    const viewersEl = countersContainer.querySelector('[data-counter="viewers"]');
    const cartEl = countersContainer.querySelector('[data-counter="cart"]');
    
    if (!viewersEl || !cartEl) return;

    // Get initial values
    let viewersCount = parseInt(viewersEl.textContent) || 12;
    let cartCount = parseInt(cartEl.textContent) || 3;

    // Store product ID for persistence
    const productId = countersContainer.dataset.productId;
    const storageKey = 'urgency_counters_' + productId;

    // Try to load persisted values (simulate realistic persistence)
    try {
      const stored = localStorage.getItem(storageKey);
      if (stored) {
        const data = JSON.parse(stored);
        const timeDiff = Date.now() - data.timestamp;
        // If less than 5 minutes, use stored values with slight variation
        if (timeDiff < 300000) {
          viewersCount = Math.max(8, Math.min(25, data.viewers + Math.floor(Math.random() * 3) - 1));
          cartCount = Math.max(1, Math.min(8, data.cart + Math.floor(Math.random() * 2) - 1));
        }
      }
    } catch (e) {
      // Ignore errors
    }

    // Update display
    function updateDisplay() {
      viewersEl.textContent = viewersCount;
      cartEl.textContent = cartCount;
      
      // Save to localStorage
      try {
        localStorage.setItem(storageKey, JSON.stringify({
          viewers: viewersCount,
          cart: cartCount,
          timestamp: Date.now()
        }));
      } catch (e) {
        // Ignore errors
      }
    }

    // Animate number change
    function animateChange(element, oldVal, newVal) {
      if (oldVal === newVal) return;
      
      const duration = 300;
      const startTime = Date.now();
      const difference = newVal - oldVal;
      
      function update() {
        const elapsed = Date.now() - startTime;
        const progress = Math.min(elapsed / duration, 1);
        const current = Math.round(oldVal + (difference * progress));
        element.textContent = current;
        
        if (progress < 1) {
          requestAnimationFrame(update);
        } else {
          element.textContent = newVal;
        }
      }
      
      update();
    }

    // Realistic counter updates
    function updateCounters() {
      // Viewers: gradual changes, mostly small increments/decrements
      const viewersChange = Math.random();
      let newViewers = viewersCount;
      
      if (viewersChange < 0.15) {
        // 15% chance: someone leaves (decrease by 1-2)
        newViewers = Math.max(8, viewersCount - Math.floor(Math.random() * 2 + 1));
      } else if (viewersChange < 0.85) {
        // 70% chance: small change (+1 or -1)
        newViewers = Math.max(8, Math.min(25, viewersCount + (Math.random() < 0.5 ? -1 : 1)));
      } else {
        // 15% chance: someone new arrives (+1 or +2)
        newViewers = Math.min(25, viewersCount + Math.floor(Math.random() * 2 + 1));
      }

      // Cart: less frequent changes, smaller range
      const cartChange = Math.random();
      let newCart = cartCount;
      
      if (cartChange < 0.1) {
        // 10% chance: someone removes from cart
        newCart = Math.max(1, cartCount - 1);
      } else if (cartChange < 0.25) {
        // 15% chance: someone adds to cart
        newCart = Math.min(8, cartCount + 1);
      }
      // 75% chance: no change (cart is more stable)

      // Update with animation
      if (newViewers !== viewersCount) {
        animateChange(viewersEl, viewersCount, newViewers);
        viewersCount = newViewers;
      }
      
      if (newCart !== cartCount) {
        animateChange(cartEl, cartCount, newCart);
        cartCount = newCart;
      }
    }

    // Initial display
    updateDisplay();

    // Update every 8-15 seconds (realistic interval)
    function scheduleNextUpdate() {
      const delay = 8000 + Math.random() * 7000; // 8-15 seconds
      setTimeout(() => {
        updateCounters();
        scheduleNextUpdate();
      }, delay);
    }

    // Start updates after initial delay
    setTimeout(scheduleNextUpdate, 5000 + Math.random() * 5000);
  })();
</script>
{% render 'product-sticky', product: product %}

<div class="container">
      {% render 'breadcrumb', product: product %}
      <!-- PRODUCT TOP PART -->
      <div class="main-product product--thumbnails-{{ section.settings.thumbnails_position }}">
        {% render 'ap-productmedia', product: product %}
        <div class="product__info {%- if section.settings.media_type == 'list' -%}{{ 'product__info-scroll' | prepend: ' ' }}{%- endif -%}">
          <!-- PRODUCT META -->
          <ap-productmeta form-id="ap-productform-{{ section.id }}-{{ product.id }}" ap-priceclass="price--large" class="ap-productmeta">
              <div class="ap-productform">
                {%- for block in section.blocks -%}
    
                  {%- case block.type -%}
                    {%- when '@app' -%}
                      {% render block %}
                    
                    {%- when 'title' -%}
                      <h1 class="ap-productmeta__title heading h3">{{ product.title }}</h1>
                    
                    {%- when 'price' -%}
                      {% liquid
                        render 'price', product: product, use_variant: true, show_badges: false, price_class: 'price--large'
                      %}

                    {% if product.metafields.my_fields.countdown_timer != blank %}
                      {% render 'product-countdown' %}
                    {% endif %}
    
                    {%- when 'product_variants' -%}
                      {%- render 'ap-productvariants', product: product show_size_chart: true color_variant: block.settings.color_variant variant_type: block.settings.variant_type -%}
                    
                    {%- when 'quantity_selector' -%}
                      {%- render 'product-quantity', product: product -%}
                    
                    {%- when 'buy_buttons' -%}
                      {%- render 'product-buy',
                        block: block,
                        product: product,
                        product_form_id: product_form_id,
                        section_id: section.id,
                        show_pickup_availability: true 
                      -%}
                    
                    {%- when 'product_stock' -%}
                      {%- render 'product-stock', product: product -%}
                    
                    {%- when 'product_description' -%}
                      <div class="product-description">{{ product.description }}</div>
                    
                    {%- when 'share' -%}
                      {% render 'product-share', product: product %}
                    
                    {%- when 'custom_liquid' -%}
                      {{ block.settings.custom_liquid }}
                    
                    {%- when 'ratting' -%}
                      {%- render 'product-ratting', product: product -%}
                    
                    {%- when 'product_sku' -%}
                      {%- render 'product-sku', product: product -%}
                    
                    {%- when 'text' -%}
                      {{ block.settings.text }}
                    
                    {%- when 'free_shipping_bar' -%}
                      {% render 'ap-freeshippingbar' %}
                    
                    {%- when 'urgency_counters' -%}
                      <div class="product-urgency-counters" data-product-id="{{ product.id }}" {{ block.shopify_attributes }}>
                        <div class="urgency-counter urgency-counter--viewers">
                          <span class="urgency-counter__emoji">👀</span>
                          <span class="urgency-counter__text">
                            <span class="urgency-counter__number" data-counter="viewers">{{ block.settings.initial_viewers | default: 12 }}</span>
                            <span class="urgency-counter__label">people viewing this</span>
                          </span>
                        </div>
                        <div class="urgency-counter urgency-counter--cart">
                          <span class="urgency-counter__emoji">🔥</span>
                          <span class="urgency-counter__text">
                            <span class="urgency-counter__number" data-counter="cart">{{ block.settings.initial_cart | default: 3 }}</span>
                            <span class="urgency-counter__label">in cart right now</span>
                          </span>
                        </div>
                      </div>
                      
                  {% endcase %}
                {% endfor %}
    
              </div>
