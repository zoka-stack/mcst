{{ 'look-book-section.css' | asset_url | stylesheet_tag }}
      
{% style %}
    {% for block in section.blocks %}
        #block-{{ block.id }} {
            --section-dot-inner-background: {{ section.settings.dot_inner_background | color_extract: 'red' }}, {{ section.settings.dot_inner_background | color_extract: 'green' }}, {{ section.settings.dot_inner_background | color_extract: 'blue' }};
            --section-dot-background: {{ section.settings.dot_background | color_extract: 'red' }}, {{ section.settings.dot_background | color_extract: 'green' }}, {{ section.settings.dot_background | color_extract: 'blue' }};
        }
        {% if block.settings.product_1 %}
            #block-{{ block.id }}-1 {
                top: {{ block.settings.product_1_top }}%;
                left: {{ block.settings.product_1_left }}%;
            }
        {% endif %}
        {% if block.settings.product_2 %}
            #block-{{ block.id }}-2 {
                top: {{ block.settings.product_2_top }}%;
                left: {{ block.settings.product_2_left }}%;
            }
        {% endif %}
        {% if block.settings.product_3 %}
            #block-{{ block.id }}-3 {
                top: {{ block.settings.product_3_top }}%;
                left: {{ block.settings.product_3_left }}%;
            }
        {% endif %}
        {% if block.settings.product_4 %}
            #block-{{ block.id }}-4 {
                top: {{ block.settings.product_4_top }}%;
                left: {{ block.settings.product_4_left }}%;
            }
        {% endif %}
        {% if block.settings.product_5 %}
            #block-{{ block.id }}-5 {
                top: {{ block.settings.product_5_top }}%;
                left: {{ block.settings.product_5_left }}%;
            }
        {% endif %}
    {% endfor %}
    
    @media (max-width: 767px) {
      .popover--quick-buy .ap-productform {
        padding: 20px;
      }
      .popover--quick-buy .shopify-cleanslate {
        display: none;
      }
    }


    @media screen and (max-width: 575px) {
      #shopify-section-{{ section.id }} {
        --section-products-per-row: {{ section.settings.products_per_row_mobile }};
      }
      .lookbook-carousel-section .ap-productlist__inner--scroller{
        margin:0;
        padding:0px;
        grid-auto-columns:calc((100% - var(--ap-productlist-column-gap) * ({{ section.settings.products_per_row_mobile }} - 1)) / {{ section.settings.products_per_row_mobile }});
      } 
    }

    @media (min-width:576px) and (max-width: 767px) {
      #shopify-section-{{ section.id }} {
        --section-products-per-row: {{ section.settings.products_per_row_ipad }};
      }
      .lookbook-carousel-section .ap-productlist__inner--scroller{
        margin:0;
        padding:0px;
        grid-auto-columns:calc((100% - var(--ap-productlist-column-gap) * ({{ section.settings.products_per_row_ipad }} - 1)) / {{ section.settings.products_per_row_ipad }});
      }
 
    }
  
    @media (min-width: 768px) and (max-width: 1199px) {
      #shopify-section-{{ section.id }} {
        --section-products-per-row: {{ section.settings.products_per_row_tablet }}
      }
      .lookbook-carousel-section .ap-productlist__inner--scroller{
        margin:0;
        padding:0;
        grid-auto-columns:calc((100% - var(--ap-productlist-column-gap) * ({{ section.settings.products_per_row_tablet }} - 1)) / {{ section.settings.products_per_row_tablet }});
      }
    }
    @media screen and (min-width: 1200px) {
      #shopify-section-{{ section.id }} {
        --section-products-per-row: {{ section.settings.products_per_row_desktop }};
      }
      .lookbook-carousel-section .ap-productlist__inner--scroller{
        margin:0;
        padding:0;
        grid-auto-columns:calc((100% - var(--ap-productlist-column-gap) * ({{ section.settings.products_per_row_desktop }} - 1)) / {{ section.settings.products_per_row_desktop }});
      }
    }
{% endstyle %}

<section class="look-book-section">
  <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
        <header class="section__header ">
            <div class="text-container">
              <h3 class="heading h{{ section.settings.tab_heading_size }}">{{ section.settings.tab_heading }}</h3>
              {% if section.settings.tab_description %}
                <div class="heading-description">
                  {{ section.settings.tab_description }}
                </div>
              {% endif %}
            </div>
            <div class="btn-more">
              {% if section.settings.btn_text != blank %}
              <a href="{{ section.settings.btn_link }}" class="button btn-base-2">
                {{ section.settings.btn_text }}
                {% render 'icon-arrow-2' %}   
              </a>
              {% endif %}
            </div>
        </header>
    <div class="row">
      <div class="block-lookbook">
        <ap-lookbookshop-carousel reveal-on-scroll="" class="ap-lookbookshop-carousel ap-object-loaded" style="opacity: 1;">
            <div class="ap-lookbookshop__item-list">
                {% for block in section.blocks %}
                    <ap-lookbookshop-item-custom id="block-{{ block.id }}" class="ap-lookbookshop__item" {% if forloop.index != 1 %} {% endif %}>
                        <div class="ap-lookbookshop__image-wrapper">
                          {% if block.settings.image_wrapper != blank %}
                            <img loading="lazy" sizes="100vw" reveal="" class="ap-lookbookshop__image hd-pocket" alt="" 
                                src="{{ block.settings.image_wrapper | image_url: width: block.settings.image_wrapper.width }}" 
                                srcset="
                                    {%- if block.settings.image_wrapper.width >= 500 -%}{{ block.settings.image_wrapper | image_url: width: 500 }} 500w,{%- endif -%}
                                    {%- if block.settings.image_wrapper.width >= 700 -%}{{ block.settings.image_wrapper | image_url: width: 700 }} 700w,{%- endif -%}
                                    {%- if block.settings.image_wrapper.width >= 900 -%}{{ block.settings.image_wrapper | image_url: width: 900 }} 900w,{%- endif -%}
                                    {%- if block.settings.image_wrapper.width >= 1100 -%}{{ block.settings.image_wrapper | image_url: width: 1100 }} 1100w,{%- endif -%}
                                    {%- if block.settings.image_wrapper.width >= 1500 -%}{{ block.settings.image_wrapper | image_url: width: 1500 }} 1500w,{%- endif -%}
                                    {%- if block.settings.image_wrapper.width >= 2000 -%}{{ block.settings.image_wrapper | image_url: width: 2000 }} 2000w,{%- endif -%}
                                    {%- if block.settings.image_wrapper.width >= 2500 -%}{{ block.settings.image_wrapper | image_url: width: 2500 }} 2500w,{%- endif -%}
                                    {{ block.settings.image_wrapper | image_url }} {{ block.settings.image_wrapper.width }}w
                                "
                                style="opacity: 1;" 
                                width="{{ block.settings.image_wrapper.width }}" height="{{ block.settings.image_wrapper.width }}">
                          {% else %}
                            {{'image' | placeholder_svg_tag: 'placeholder-svg' }}
                          {% endif %}
                          {% if block.settings.image_wrapper_tablet != blank %}
                            <img loading="lazy" sizes="100vw" reveal="" class="ap-lookbookshop__image hd-lap-and-up" alt="" 
                                src="{{ block.settings.image_wrapper_tablet | image_url: width: block.settings.image_wrapper_tablet.width }}" 
                                srcset="
                                    {%- if block.settings.image_wrapper_tablet.width >= 500 -%}{{ block.settings.image_wrapper_tablet | image_url: width: 500 }} 500w,{%- endif -%}
                                    {%- if block.settings.image_wrapper_tablet.width >= 600 -%}{{ block.settings.image_wrapper_tablet | image_url: width: 600 }} 600w,{%- endif -%}
                                    {%- if block.settings.image_wrapper_tablet.width >= 700 -%}{{ block.settings.image_wrapper_tablet | image_url: width: 700 }} 700w,{%- endif -%}
                                    {%- if block.settings.image_wrapper_tablet.width >= 800 -%}{{ block.settings.image_wrapper_tablet | image_url: width: 800 }} 800w,{%- endif -%}
                                    {%- if block.settings.image_wrapper_tablet.width >= 900 -%}{{ block.settings.image_wrapper_tablet | image_url: width: 900 }} 900w,{%- endif -%}
                                    {%- if block.settings.image_wrapper_tablet.width >= 1000 -%}{{ block.settings.image_wrapper_tablet | image_url: width: 1000 }} 1000w,{%- endif -%}
                                    {{ block.settings.image_wrapper_tablet | image_url }} {{ block.settings.image_wrapper_tablet.width }}w
                                "
                                style="opacity: 1;" width="{{ block.settings.image_wrapper_tablet.width }}" height="{{ block.settings.image_wrapper_tablet.width }}">
                          {% else %}
                            {{'image' | placeholder_svg_tag: 'placeholder-svg' }}
                          {% endif %}
                        </div>   
                        {% if block.settings.product_1 != null %}
                            <div id="block-{{ block.id }}-1" class="ap-lookbookshop__product-wrapper">
                                <button type="button" is="toggle-button" reveal="" class="ap-lookbookshop__dot tap-area hd-phone" ap-controlsaria="block-{{ block.id }}-1-product" ap-expanded-aria="{% if block.settings.product_1.product_1_show %}true{% else %}false{% endif %}" style="opacity: 1;">
                                    <span class="visually-hidden">{{ block.settings.product_1.title }}</span>
                                </button>
            
                                <button type="button" is="toggle-button" reveal="" class="ap-lookbookshop__dot tap-area hd-tablet-and-up" ap-controlsaria="block-{{ block.id }}-1-popover" ap-expanded-aria="{% if block.settings.product_1.product_1_show %}true{% else %}false{% endif %}" style="opacity: 1;">
                                    <span class="visually-hidden">{{ block.settings.product_1.title }}</span>
                                </button>
            
                                <ap-elementopen id="block-{{ block.id }}-1-product" class="ap-lookbookshop__product ap-lookbookshop__product--reverse hd-phone" {% if block.settings.product_1.product_1_show %}open=""{% endif %}>
