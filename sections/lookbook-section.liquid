                                            <button is="toggle-button" class="ap-lookbookshop__product-link link text--subdued" ap-controlsaria="block-{{ block.id }}-5-drawer" ap-expanded-aria="{% if block.settings.product_5.product_5_show %}true{% else %}false{% endif %}">Quick view</button>
                                        </div>
                                    </div>
                                </ap-elementopen>
                          
                                <ap-popoverquickbuy href="/products/{{ block.settings.product_5.handle }}?view=quick-buy-popover" id="block-{{ block.id }}-5-popover" class="popover popover--quick-buy"></ap-popoverquickbuy>
                                <ap-quickbuy href="/products/{{ block.settings.product_5.handle }}?view=quick-buy-drawer" id="block-{{ block.id }}-5-drawer" class="drawer drawer--large drawer--quick-buy"></ap-quickbuy>
                            </div>
                          {% endif %}
                    </ap-lookbookshop-item-custom>
                {% endfor %}
                
            </div>

            <div class="lookbook-carousel-arrow">
                <ap-button-nextprev class="lookbook-carousel__ap-nextprev hd-pocket" style="--smallest-image-aspect-ratio: 1.0">
