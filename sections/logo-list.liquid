{{ 'ap-logolist.css' | asset_url | stylesheet_tag }}
{% render 'section-style' %}

<style>
    #shopify-section-{{ section.id }} {
        --heading-color: {{ section.settings.heading_color | color_extract: 'red' }}, {{ section.settings.heading_color | color_extract: 'green' }}, {{ section.settings.heading_color | color_extract: 'blue' }};
        --color-body: {{ section.settings.text_color | color_extract: 'red' }}, {{ section.settings.text_color | color_extract: 'green' }}, {{ section.settings.text_color | color_extract: 'blue' }};
      --primary-button-background: 244, 165, 28;
      --primary-button-text-color: 255, 255, 255;
  
      --ap-nextap-buttonprev-background: 255, 255, 255;
      --ap-nextap-buttonprev-color: 40, 40, 40;
  
      --section-background: {{ section.settings.section_background | color_extract: 'red' }}, {{ section.settings.section_background | color_extract: 'green' }}, {{ section.settings.section_background | color_extract: 'blue' }};
      --section-logo-background: 0 0 0 / 0.0;
    }

    @media screen and (min-width: 741px) {
      #shopify-section-{{ section.id }} {
        --section-items-per-row: {{ section.settings.items_per_row_mobile }};
      }
    }
  
    @media screen and (min-width: 1000px) {
      #shopify-section-{{ section.id }} {
        --section-items-per-row: {{ section.settings.items_per_row_tablet }}
      }
    }
  
    @media screen and (min-width: 1200px) {
      #shopify-section-{{ section.id }} {
        --section-items-per-row: {{ section.settings.desktop_1500 }};
      }
    }

    @media screen and (min-width: 1500px) {
      #shopify-section-{{ section.id }} {
        --section-items-per-row: {{ section.settings.items_per_row_desktop }};
      }
    }
  </style>
  
<section class="section section-logo {% if section.settings.show_newsletter %}{{ 'email-with-logo' | prepend: ' ' }}{% endif %}">
  <div class="{%- if section.settings.fullwidth -%}container-fluid{%- else -%}container{%- endif -%}">
      {% if section.settings.heading != blank or section.settings.heading_2 != blank %}
          <header class="section__header container text-container">
              {% if section.settings.heading != blank %}
                  <h2 class="heading h{{ section.settings.heading_size_range }}">{{ section.settings.heading }}</h2>
              {% endif %}
              {% if section.settings.heading_2 != blank %}
                  <h3 class="heading h{{ section.settings.heading_2_size_range }}">{{ section.settings.heading_2 }}</h3>
              {% endif %}
              {% if section.settings.description != blank %}
                  <div class="heading {{ section.settings.description_size }}">
                  {{ section.settings.description }}
                  </div>
              {% endif %} 
          </header>
      {% endif %}
      <div class="{% if section.settings.show_newsletter %}row{% endif %}">
        {% if section.settings.show_newsletter %}
        <div class="column-email">
          <h2 class="heading heading--small heading-newsletter">{{ section.settings.heading_newsletter }}</h2>
          <div class="description-newsletter">
            {{ section.settings.description_newsletter }}
          </div>
          <div class="email-form" {{ block.shopify_attributes }}>
            {% form 'customer', class: 'newsletter-form' %}
              <input type="hidden" name="form_type" value="customer">
              <input type="hidden" name="utf8" value="✓">
              <input type="hidden" name="contact[tags]" value="newsletter">
              <input type="hidden" name="contact[context]" value="newsletter-{{ section.id }}">
  
              <div class="wp-newsletter-input">
                <div class="input-row">
                  <div class="input">
                    <input type="email" id="newsletter[{{ section.id }}][contact][email]" name="contact[email]" class="input__field" required="">
                    <label for="newsletter[{{ section.id }}][contact][email]" class="input__label">{{ 'newsletter.label' | t }}</label>
                  </div>
                </div>
                <div class="input">
                  <button type="submit" is="loader-button" class="button button-newsletter">
                    <span class="ap-text-loaderbutton">
                      {{ 'newsletter.button_label' | t }}
                    </span>
                    <span class="ap-loader-loaderbutton" hidden="">
                      <div class="spinner">
                        <svg focusable="false" width="24" height="24" class="icon icon--spinner" viewBox="25 25 50 50">
                          <circle cx="50" cy="50" r="20" fill="none" stroke="currentColor" stroke-width="5"></circle>
                        </svg>
                      </div>
                    </span>
                  </button>
                </div>
              </div>
  
              {%- if form.errors -%}
                <small class="newsletter-form__message form__message" id="Newsletter-error--{{ section.id }}">{% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</small>
              {%- endif -%}
              {%- if form.posted_successfully? -%}
                <div class="form__banner banner banner--success">
                  <span class="banner__ribbon">
                    <svg focusable="false" width="18" height="26" class="icon icon--form-success   " viewBox="0 0 18 26">
                      <circle fill="none" cx="9" cy="13" r="8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></circle>
                      <path fill="none" d="M5 13l3 3 5-6" stroke="currentColor" stroke-width="1.5"></path>
                    </svg>
                  </span>
                  <p class="banner__content">{{ 'newsletter.success' | t }}</p>
                </div>
              {%- endif -%}
  
            {% endform %}
          </div>
        </div>
        {% endif %}
        <div class="scroller">
          <div class="scroller__inner">
              <ap-logolist reveal-on-scroll="" class="ap-logolist ap-logolist--carousel ap-object-loaded" style="opacity: 1;">
                  <div class="ap-logolist__list">
                    {% for block in section.blocks %}
                      {% if block.settings.image != blank or block.settings.logo_svg != blank %}

                            <div class="ap-logolist__item">
                              {% if section.settings.show_image %}
                                <img loading="lazy" sizes="200px" class="ap-logolist__image"
                                  alt="" 
                                  src="{{ block.settings.image | image_url: block.settings.image.width }}" 
                                  srcset="{{ block.settings.image | image_url: width: 200 }} 200w, {{ block.settings.image | image_url: width: 300 }} 300w, {{ block.settings.image | image_url: width: 400 }} 400w" 
                                  width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
                              {% else %}

                              {% if block.settings.logo_svg != blank %}
                              <span>
                                {{ block.settings.logo_svg }}
                              </span>
                              {% endif %}

                              {% endif %}

                            </div>

                      {% else %}
                        <div class="ap-logolist__image">
                          {{ 'image' | placeholder_svg_tag }}
                        </div>
                      {% endif %}
                    {% endfor %}
                  </div>
              </ap-logolist>
            </div>
        </div>
      </div>
      </div>
  </div>
</section>
  
  

{% schema %}
{
  "name": "Logo List",
  "tag": "section",
  "class": "shopify-section--ap-logolist",
  "settings": [
    {
      "type": "checkbox",
      "id": "fullwidth",
      "label": "t:sections.all.fullwidth.label",
      "default": false
    },
    {
      "type": "color",
      "id": "section_background",
      "default": "#ffffff",
      "label": "t:sections.all.section_background.label"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "t:sections.all.background_image.label"
    },
    {
      "type": "color",
      "id": "heading_color",
      "default": "#282828",
      "label": "t:sections.all.heading_color.label"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#282828",
      "label": "t:sections.all.text_color.label"
    },
    {
      "type": "range",
      "id": "items_per_row_mobile",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 2,
      "label": "t:sections.all.items_per_row_mobile.label"
    },
    {
      "type": "range",
      "id": "items_per_row_tablet",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "t:sections.all.items_per_row_tablet.label"
    },
    {
      "type": "range",
      "id": "desktop_1500",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "Desktop 1500"
    },
    {
      "type": "range",
      "id": "items_per_row_desktop",
      "min": 1,
      "max": 10,
      "step": 1,
      "default": 4,
      "label": "t:sections.all.items_per_row_desktop.label"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:sections.all.heading.label"
    },
    {
      "type": "range",
      "id": "heading_size_range",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.all.heading_size_range.label"
    },
    {
      "type": "text",
      "id": "heading_2",
      "label": "t:sections.all.heading_2.label"
    },
    {
      "type": "range",
      "id": "heading_2_size_range",
      "min": 1,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "t:sections.all.heading_2_size_range.label"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:sections.all.description.label"
    },
    {
      "type": "select",
      "id": "description_size",
      "options": [
        {
          "value": "heading--xxsmall",
          "label": "t:sections.all.description_size.options__1.label"
        },
        {
          "value": "heading--xsmall",
          "label": "t:sections.all.description_size.options__2.label"
        },
        {
          "value": "heading--small",
          "label": "t:sections.all.description_size.options__3.label"
        },
        {
          "value": "",
          "label": "t:sections.all.description_size.options__4.label"
        },
        {
          "value": "heading--large",
          "label": "t:sections.all.description_size.options__5.label"
        }
      ],
      "default": "heading--xsmall",
      "label": "t:sections.all.description_size.label"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show image"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show Newsletter"
    },
    {
      "type": "header",
      "content": "Newsletter settings"
    },
    {
      "type": "text",
      "id": "heading_newsletter",
      "label": "Heading"
    },
    {
      "type": "text",
      "id": "description_newsletter",
      "label": "Description"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:sections.all.image.label"
        },
        {
          "type": "liquid",
          "id": "logo_svg",
          "label": "Logo Svg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logo list",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
