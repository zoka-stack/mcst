{%- liquid
  assign heading_font = section.settings.heading_font
  assign subheading_font = section.settings.subheading_font
  assign body_font = section.settings.body_font
-%}

<link rel="stylesheet" href="{{ 'section-main-page.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-rte.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-main-page.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-rte.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  {{ heading_font | font_face: font_display: 'swap' }}
  {{ subheading_font | font_face: font_display: 'swap' }}
  {{ body_font | font_face: font_display: 'swap' }}

  #request-city-{{ section.id }} {
    --rqf-background: {{ section.settings.background_color }};
    --rqf-heading-color: {{ section.settings.heading_color }};
    --rqf-subheading-color: {{ section.settings.subheading_color }};
    --rqf-text-color: {{ section.settings.text_color }};
    --rqf-button-bg: {{ section.settings.button_background }};
    --rqf-button-color: {{ section.settings.button_text_color }};
    --rqf-input-border: {{ section.settings.input_border_color }};
    --rqf-input-bg: {{ section.settings.input_background }};
    --rqf-heading-font: {{ heading_font.family }}, {{ heading_font.fallback_families }};
    --rqf-subheading-font: {{ subheading_font.family }}, {{ subheading_font.fallback_families }};
    --rqf-body-font: {{ body_font.family }}, {{ body_font.fallback_families }};
    --rqf-heading-size: {{ section.settings.heading_font_size }}px;
    --rqf-subheading-size: {{ section.settings.subheading_font_size }}px;
    --rqf-body-size: {{ section.settings.body_font_size }}px;
  }

  #request-city-{{ section.id }} {
    color: var(--rqf-text-color);
    font-family: var(--rqf-body-font);
    font-size: var(--rqf-body-size);
  }

  /* Hero block: same pattern as about-us (background image + color, title) */
  #request-city-{{ section.id }} .request-city-hero {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {% if section.settings.image != blank %}
      background-image: url({{ section.settings.image | image_url: width: 2000 }});
      background-size: cover;
      background-position: center;
    {% endif %}
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    #request-city-{{ section.id }} .request-city-hero {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  /* Override main-page-title with schema fonts/colors */
  #request-city-{{ section.id }} .main-page-title.rqf-heading {
    font-family: var(--rqf-heading-font);
    font-size: var(--rqf-heading-size);
    color: var(--rqf-heading-color);
    margin: 0 0 1rem;
    line-height: 1.2;
  }

  #request-city-{{ section.id }} .main-content-page {
    padding: {{ section.settings.content_padding | default: '30px 0 60px' }};
  }

  #request-city-{{ section.id }} .rqf-subheading {
    font-family: var(--rqf-subheading-font);
    font-size: var(--rqf-subheading-size);
    color: var(--rqf-subheading-color);
    margin: 0 0 2rem;
    line-height: 1.4;
  }

  #request-city-{{ section.id }} .rqf-form .field__input {
    background: var(--rqf-input-bg);
    border: 2px solid var(--rqf-input-border);
    color: var(--rqf-text-color);
    font-family: var(--rqf-body-font);
    font-size: var(--rqf-body-size);
  }

  #request-city-{{ section.id }} .rqf-form .field__label {
    color: var(--rqf-subheading-color);
    font-family: var(--rqf-body-font);
  }

  #request-city-{{ section.id }} .rqf-form .rqf-submit {
    background: var(--rqf-button-bg);
    color: var(--rqf-button-color);
    font-family: var(--rqf-heading-font);
    font-size: {{ section.settings.button_font_size }}px;
    border: none;
    padding: {{ section.settings.button_padding_y }}px {{ section.settings.button_padding_x }}px;
    cursor: pointer;
    width: 100%;
    max-width: 100%;
  }

  #request-city-{{ section.id }} .rqf-form .rqf-submit:hover {
    opacity: 0.9;
  }
{%- endstyle -%}

<section id="request-city-{{ section.id }}" class="request-city-form">
  <div class="page-width page-width--narrow request-city-hero">
    {% if section.settings.heading != blank %}
      <h1 class="main-page-title page-title h0 rqf-heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}
  </div>

  <div class="main-content-page">
    <div class="container">
      {% if section.settings.subheading != blank %}
        <p class="rqf-subheading">{{ section.settings.subheading | escape }}</p>
      {% endif %}

      {% form 'contact', id: 'RequestCityForm', class: 'rqf-form' %}
      <input type="hidden" name="contact[tags]" value="request_city">

      {% if form.posted_successfully? %}
        <div class="form__message form__message--success" tabindex="-1" autofocus>
          {% render 'icon-success' %}
          {{ section.settings.success_message | default: 'Thanks! We received your city request.' }}
        </div>
      {% endif %}

      {% if form.errors %}
        <div class="form__message form__message--error" role="alert" tabindex="-1" autofocus>
          {% render 'icon-error' %}
          <span>{{ 'templates.contact.form.error_heading' | t }}</span>
          <ul style="margin-top: 0.5rem; padding-left: 1.5rem;">
            {% for field in form.errors %}
              <li>
                <a href="#RequestCityForm-{{ field }}-{{ section.id }}">
                  {{ form.errors.translated_fields[field] | capitalize }}
                  {{ form.errors.messages[field] }}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}

      <div class="field">
        <input
          type="text"
          id="RequestCityForm-name-{{ section.id }}"
          name="contact[name]"
          class="field__input"
          value="{{ form.name }}"
          autocomplete="name"
          placeholder="{{ section.settings.name_placeholder | default: 'Your name' }}"
          required
        >
        <label class="field__label" for="RequestCityForm-name-{{ section.id }}">{{ section.settings.name_label | default: 'Name' }} <span aria-hidden="true">*</span></label>
      </div>

      <div class="field">
        <input
          type="email"
          id="RequestCityForm-email-{{ section.id }}"
          name="contact[email]"
          class="field__input"
          value="{{ form.email }}"
          autocomplete="email"
          placeholder="{{ section.settings.email_placeholder | default: 'your@email.com' }}"
          required
        >
        <label class="field__label" for="RequestCityForm-email-{{ section.id }}">{{ section.settings.email_label | default: 'Email' }} <span aria-hidden="true">*</span></label>
      </div>

      <div class="field">
        <input
          type="text"
          id="RequestCityForm-city-{{ section.id }}"
          name="contact[body]"
          class="field__input"
          value="{{ form.body }}"
          autocomplete="off"
          placeholder="{{ section.settings.city_placeholder | default: 'Start typing your city...' }}"
          required
          aria-describedby="city-hint-{{ section.id }}"
        >
        <label class="field__label" for="RequestCityForm-city-{{ section.id }}">{{ section.settings.city_label | default: 'City' }} <span aria-hidden="true">*</span></label>
        <span id="city-hint-{{ section.id }}" class="visually-hidden">City is selected from suggestions for accuracy.</span>
      </div>

      <div class="field" style="margin-top: 1.5rem;">
        <button type="submit" class="button rqf-submit">
          {{ section.settings.button_label | default: 'Submit Request' }}
        </button>
      </div>
      {% endform %}
    </div>
  </div>
</section>

{% if section.settings.google_places_api_key != blank %}
  <script src="https://maps.googleapis.com/maps/api/js?key={{ section.settings.google_places_api_key | escape }}&libraries=places" async defer></script>
  <script>
    (function() {
      var sectionId = '{{ section.id }}';
      var inputId = 'RequestCityForm-city-' + sectionId;
      var apiKey = '{{ section.settings.google_places_api_key | escape }}';

      function initAutocomplete() {
        if (typeof google === 'undefined' || !google.maps || !google.maps.places) {
          setTimeout(initAutocomplete, 100);
          return;
        }
        var input = document.getElementById(inputId);
        if (!input) return;
        var autocomplete = new google.maps.places.Autocomplete(input, {
          types: ['(cities)'],
          fields: ['formatted_address', 'address_components']
        });
        autocomplete.addListener('place_changed', function() {
          var place = autocomplete.getPlace();
          if (place && place.address_components) {
            var city = '';
            for (var i = 0; i < place.address_components.length; i++) {
              var comp = place.address_components[i];
              if (comp.types.indexOf('locality') !== -1) {
                city = comp.long_name;
                break;
              }
            }
            if (!city && place.formatted_address) city = place.formatted_address;
            input.value = city;
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAutocomplete);
      } else {
        initAutocomplete();
      }
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Request a City",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Hero (about-us style)"
