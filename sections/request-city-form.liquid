    },
    {
      "type": "color",
      "id": "button_background",
      "label": "Button background",
      "default": "#aeef00"
    },
    {
      "type": "color",
      "id": "button_text_color",
      "label": "Button text color",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Submit Request"
    },
    {
      "type": "range",
      "id": "button_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
