<link rel="stylesheet" href="{{ 'section-founders-circle.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-newsletter.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'section-founders-circle.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .founders-circle__heading {
    color: {{ section.settings.heading_color | default: '#ffffff' }};
  }

  .founders-circle__subheading {
    color: {{ section.settings.text_color | default: '#ffffff' }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient founders-circle section-{{ section.id }}-padding">
  <div class="page-width page-width--narrow">
    <div class="founders-circle__container">
      {%- if section.settings.heading != blank -%}
        <h1 class="founders-circle__heading main-page-title page-title {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="founders-circle__subheading rte">
          {{ section.settings.subheading }}
        </div>
      {%- endif -%}

      {%- comment -%} Image Placeholders for Mockups {%- endcomment -%}
      <div class="founders-circle__mockups">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when 'mockup_image' -%}
              <div class="founders-circle__mockup-item" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  <div class="founders-circle__mockup-image">
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag: loading: 'lazy', alt: block.settings.image.alt | default: 'Product mockup'
                    }}
                  </div>
                {%- else -%}
                  <div class="founders-circle__mockup-placeholder">
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    <span class="founders-circle__placeholder-text">Mockup {{ forloop.index }}</span>
                  </div>
                {%- endif -%}
                {%- if block.settings.caption != blank -%}
                  <p class="founders-circle__mockup-caption">{{ block.settings.caption | escape }}</p>
                {%- endif -%}
              </div>
          {%- endcase -%}
        {%- endfor -%}

        {%- comment -%} Default placeholders if no blocks {%- endcomment -%}
        {%- if section.blocks.size == 0 -%}
          {%- for i in (1..3) -%}
            <div class="founders-circle__mockup-item">
              <div class="founders-circle__mockup-placeholder">
                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                <span class="founders-circle__placeholder-text">Mockup {{ i }}</span>
              </div>
            </div>
          {%- endfor -%}
        {%- endif -%}
      </div>

      {%- comment -%} Email Capture Form {%- endcomment -%}
      <div class="founders-circle__email-form">
        <h2 class="founders-circle__form-heading">{{ section.settings.form_heading | default: "Join the Founder's Circle" }}</h2>
        {%- if section.settings.form_description != blank -%}
          <p class="founders-circle__form-description">{{ section.settings.form_description | escape }}</p>
        {%- endif -%}

        {% form 'customer', class: 'newsletter-form founders-circle__form' %}
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="founders-circle">
          <input type="hidden" name="contact[context]" value="founders-circle-{{ section.id }}">

          <div class="newsletter-form__field-wrapper">
            <div class="field">
              <input
                type="email"
                id="FoundersCircle-email-{{ section.id }}"
                name="contact[email]"
                class="field__input"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                required
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="FoundersCircle-email-error-{{ section.id }}"
                {% endif %}
                placeholder="{{ section.settings.email_placeholder | default: 'Enter your email address' }}"
              >
              <label class="field__label" for="FoundersCircle-email-{{ section.id }}">
                {{ section.settings.email_label | default: 'Email address' }}
                <span aria-hidden="true">*</span>
              </label>
            </div>
            {%- if form.errors contains 'email' -%}
              <small class="newsletter-form__message form__message" id="FoundersCircle-email-error-{{ section.id }}">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                <span>{% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</span>
              </small>
            {%- endif -%}
          </div>

          <button type="submit" class="button newsletter-form__button founders-circle__submit" name="commit" id="Subscribe">
            <span>{{ section.settings.button_text | default: "Join Now" }}</span>
            <span class="visually-hidden">{{ 'newsletter.button_label' | t }}</span>
          </button>

          {%- if form.posted_successfully? -%}
            <div class="newsletter-form__message newsletter-form__message--success form__message" tabindex="-1" autofocus>
              {% render 'icon-success' -%}
              <span>{{ section.settings.success_message | default: "Thank you! You've been added to the Founder's Circle." }}</span>
            </div>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Founder's Circle",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the Founder's Circle"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Be among the first to experience our exclusive collection</p>"
    },
    {
      "type": "header",
      "content": "Email Form Settings"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Join the Founder's Circle"
    },
    {
      "type": "text",
      "id": "form_description",
      "label": "Form Description",
      "default": "Get exclusive access and early updates"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Join Now"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you! You've been added to the Founder's Circle."
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#282828"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "blocks": [
    {
      "type": "mockup_image",
      "name": "Mockup Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Founder's Circle",
      "blocks": [
        {
          "type": "mockup_image"
        },
        {
          "type": "mockup_image"
        },
        {
          "type": "mockup_image"
        }
      ]
    }
  ]
}
{% endschema %}

