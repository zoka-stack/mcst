{%- style -%}
  #mcst-coming-soon-{{ section.id }} {
    position: relative;
    min-height: 100vh;
    background-color: #282828;
    color: #ffffff;
  }

  #mcst-coming-soon-{{ section.id }}::before {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      linear-gradient(135deg, rgba(0, 0, 0, 0.3) 0%, rgba(0, 0, 0, 0.1) 100%),
      url("data:image/svg+xml,%3Csvg width='100' height='100' xmlns='http://www.w3.org/2000/svg'%3E%3Cdefs%3E%3Cpattern id='chicago' x='0' y='0' width='100' height='100' patternUnits='userSpaceOnUse'%3E%3Crect width='100' height='33.33' fill='%23ffffff' opacity='0.02'/%3E%3Crect y='33.33' width='100' height='33.33' fill='%23000000' opacity='0.02'/%3E%3Crect y='66.66' width='100' height='33.33' fill='%23ffffff' opacity='0.02'/%3E%3C/pattern%3E%3C/defs%3E%3Crect width='100' height='100' fill='url(%23chicago)'/%3E%3C/svg%3E");
    background-size: 200px 200px;
    pointer-events: none;
    z-index: 0;
    opacity: 0.3;
  }

  #mcst-coming-soon-{{ section.id }}::after {
    content: '';
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      repeating-linear-gradient(
        0deg,
        transparent,
        transparent 2px,
        rgba(255, 255, 255, 0.01) 2px,
        rgba(255, 255, 255, 0.01) 4px
      );
    pointer-events: none;
    z-index: 0;
  }

  #mcst-coming-soon-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  .mcst-sticky-header {
    position: sticky;
    top: 0;
    z-index: 100;
    background-color: rgba(40, 40, 40, 0.95);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.5rem 0;
  }

  .mcst-rotating-text {
    min-height: 2.4rem;
    display: inline-block;
  }

  .mcst-hook-item {
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .mcst-hook-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .mcst-hook-item.active .mcst-hook-content {
    max-height: 500px;
  }
{%- endstyle -%}

<div id="mcst-coming-soon-{{ section.id }}">
  <!-- Sticky Header -->
  <div class="mcst-sticky-header">
    <div class="page-width" style="display: flex; justify-content: space-between; align-items: center;">
      <div class="h3" style="margin: 0; font-weight: 600;">MyCityStandsTogether</div>
      <div style="display: flex; align-items: center; gap: 2rem;">
        <small style="font-size: 1.1rem; opacity: 0.7;">Updated January 2026, Foundational Growth Phase</small>
        <a href="#mcst-signup" class="button button--primary" style="text-decoration: none;">Founder's Circle</a>
      </div>
    </div>
  </div>

  <!-- Hero -->
  <section style="padding: 8rem 0; text-align: center;">
    <div class="page-width" style="max-width: 80rem;">
      <h1 class="h0" style="margin-bottom: 2rem;">{{ section.settings.hero_heading | default: "Join the Founder's Circle" }}</h1>
      <div class="rte" style="font-size: 1.8rem; margin-bottom: 3rem; max-width: 60rem; margin-left: auto; margin-right: auto;">
        {{ section.settings.hero_subhead | default: "<p>Slow build, real Chicago, foundation first. We're not rushing, we're building something that lasts.</p>" }}
      </div>
      <div style="margin-bottom: 4rem;">
        <a href="#mcst-signup" class="button button--primary" style="margin-right: 2rem; text-decoration: none;">Join Now</a>
        <a href="#mcst-why" style="text-decoration: underline; opacity: 0.8;">Why we exist</a>
      </div>
      <div class="mcst-rotating-text" style="font-size: 1.4rem; opacity: 0.7; font-style: italic;">
        <span class="mcst-rotate-text">Chicago pride, Chicago progress</span>
      </div>
    </div>
  </section>

  <!-- The Why -->
  <section id="mcst-why" style="padding: 6rem 0; background-color: rgba(40, 40, 40, 0.5);">
    <div class="page-width">
      <h2 class="h1" style="margin-bottom: 3rem; text-align: center;">Big brands sell Chicago, neighborhoods get scraps</h2>
      <div class="rte" style="max-width: 70rem; margin: 0 auto; font-size: 1.6rem; line-height: 1.8;">
        <p>We're a social enterprise, not a 501(c)(3). That means we can move fast, make decisions, and put money directly back into Chicago neighborhoods. No grant cycles, no board approvals for every move. Just real work, real impact, real Chicago.</p>
      </div>
    </div>
  </section>

  <!-- What is Founder's Circle -->
  <section style="padding: 6rem 0;">
    <div class="page-width">
      <h2 class="h1" style="margin-bottom: 4rem; text-align: center;">What is the Founder's Circle</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 2rem; margin-bottom: 4rem;">
        <div style="padding: 2rem; background-color: rgba(40, 40, 40, 0.6); border-radius: 8px;">
          <h3 class="h3" style="margin-bottom: 1rem;">Early Access</h3>
          <p>First dibs on drops, exclusive pieces, and behind-the-scenes updates.</p>
        </div>
        <div style="padding: 2rem; background-color: rgba(40, 40, 40, 0.6); border-radius: 8px;">
          <h3 class="h3" style="margin-bottom: 1rem;">Direct Impact</h3>
          <p>See exactly where your support goes, which organizations we're backing, and the real numbers.</p>
        </div>
        <div style="padding: 2rem; background-color: rgba(40, 40, 40, 0.6); border-radius: 8px;">
          <h3 class="h3" style="margin-bottom: 1rem;">Founder Pricing</h3>
          <p>Lock in better rates on future releases as a thank you for believing early.</p>
        </div>
        <div style="padding: 2rem; background-color: rgba(40, 40, 40, 0.6); border-radius: 8px;">
          <h3 class="h3" style="margin-bottom: 1rem;">Community Input</h3>
          <p>Your voice shapes what we build next. Real feedback, real influence.</p>
        </div>
      </div>
      <div class="rte" style="max-width: 70rem; margin: 0 auto; padding: 2rem; background-color: rgba(40, 40, 40, 0.6); border-radius: 8px; border-left: 3px solid #aeef00;">
        <p><strong>Real talk on donations:</strong> We're not writing five-figure checks today. The intention is baked in, we're vetting partners now, and when we're ready, Founder's Circle members will be the first to know where the money goes. This is about building something real, not promises.</p>
      </div>
    </div>
  </section>

  <!-- Hooks -->
  {% if section.settings.show_hooks %}
  <section style="padding: 6rem 0; background-color: rgba(40, 40, 40, 0.5);">
    <div class="page-width">
      <h2 class="h1" style="margin-bottom: 2rem; text-align: center;">Conversation Starters</h2>
      <p style="text-align: center; margin-bottom: 4rem; opacity: 0.7;">Not scripts, just starting points for real conversations.</p>
      <div class="mcst-hooks-container" style="max-width: 70rem; margin: 0 auto;">
        <div class="mcst-hook-item">
          <button class="mcst-hook-trigger" style="width: 100%; text-align: left; padding: 2rem; background: none; border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
            <span>Big Shoulders Fund</span>
            <span class="mcst-hook-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-hook-content">
            <div style="padding: 0 2rem 2rem 2rem;">
              <p>Supporting Catholic schools in Chicago's most underserved neighborhoods. Ask about their impact on graduation rates and college enrollment.</p>
            </div>
          </div>
        </div>
        <div class="mcst-hook-item">
          <button class="mcst-hook-trigger" style="width: 100%; text-align: left; padding: 2rem; background: none; border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
            <span>Thrive Chicago</span>
            <span class="mcst-hook-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-hook-content">
            <div style="padding: 0 2rem 2rem 2rem;">
              <p>Working to close the opportunity gap for Chicago's youth. Ask about their cradle-to-career approach and measurable outcomes.</p>
            </div>
          </div>
        </div>
        <div class="mcst-hook-item">
          <button class="mcst-hook-trigger" style="width: 100%; text-align: left; padding: 2rem; background: none; border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
            <span>Dreams for Kids</span>
            <span class="mcst-hook-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-hook-content">
            <div style="padding: 0 2rem 2rem 2rem;">
              <p>Empowering youth with disabilities through adaptive sports and leadership programs. Ask about their inclusive approach and community impact.</p>
            </div>
          </div>
        </div>
        <div class="mcst-hook-item">
          <button class="mcst-hook-trigger" style="width: 100%; text-align: left; padding: 2rem; background: none; border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
            <span>Special Children's Charities</span>
            <span class="mcst-hook-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-hook-content">
            <div style="padding: 0 2rem 2rem 2rem;">
              <p>Supporting Chicago Park District programs for children and adults with disabilities. Ask about their adaptive recreation programs and community integration.</p>
            </div>
          </div>
        </div>
        <div class="mcst-hook-item">
          <button class="mcst-hook-trigger" style="width: 100%; text-align: left; padding: 2rem; background: none; border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
            <span>StreetWise</span>
            <span class="mcst-hook-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-hook-content">
            <div style="padding: 0 2rem 2rem 2rem;">
              <p>Creating economic opportunity for people experiencing homelessness through employment and support services. Ask about their vendor program and success stories.</p>
            </div>
          </div>
        </div>
        <div class="mcst-hook-item">
          <button class="mcst-hook-trigger" style="width: 100%; text-align: left; padding: 2rem; background: none; border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
            <span>Greater Chicago Food Depository</span>
            <span class="mcst-hook-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-hook-content">
            <div style="padding: 0 2rem 2rem 2rem;">
              <p>Fighting hunger across Cook County through food distribution and community programs. Ask about their network of pantries and impact on food insecurity.</p>
            </div>
          </div>
        </div>
        <div class="mcst-hook-item">
          <button class="mcst-hook-trigger" style="width: 100%; text-align: left; padding: 2rem; background: none; border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center;">
            <span>Chicago Cares</span>
            <span class="mcst-hook-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-hook-content">
            <div style="padding: 0 2rem 2rem 2rem;">
              <p>Mobilizing volunteers to address critical needs across Chicago. Ask about their volunteer programs and community partnerships.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Exchange -->
  <section style="padding: 6rem 0;">
    <div class="page-width">
      <h2 class="h1" style="margin-bottom: 4rem; text-align: center;">The Exchange</h2>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 4rem;">
        <div>
          <h3 class="h2" style="margin-bottom: 2rem;">How we help you</h3>
          <ul style="list-style: none; padding: 0;">
            <li style="margin-bottom: 1.5rem; padding-left: 2rem; position: relative;">
              <span style="position: absolute; left: 0;">→</span>
              <strong>Early access</strong> to drops and exclusive pieces
            </li>
            <li style="margin-bottom: 1.5rem; padding-left: 2rem; position: relative;">
              <span style="position: absolute; left: 0;">→</span>
              <strong>Transparency</strong> on where your support goes
            </li>
            <li style="margin-bottom: 1.5rem; padding-left: 2rem; position: relative;">
              <span style="position: absolute; left: 0;">→</span>
              <strong>Founder pricing</strong> on future releases
            </li>
            <li style="margin-bottom: 1.5rem; padding-left: 2rem; position: relative;">
              <span style="position: absolute; left: 0;">→</span>
              <strong>Community input</strong> on what we build next
            </li>
          </ul>
        </div>
        <div>
          <h3 class="h2" style="margin-bottom: 2rem;">What we ask of you</h3>
          <ul style="list-style: none; padding: 0;">
            <li style="margin-bottom: 1.5rem; padding-left: 2rem; position: relative;">
              <span style="position: absolute; left: 0;">→</span>
              <strong>Your email</strong> so we can keep you updated
            </li>
            <li style="margin-bottom: 1.5rem; padding-left: 2rem; position: relative;">
              <span style="position: absolute; left: 0;">→</span>
              <strong>Your interest</strong> in building something real for Chicago
            </li>
            <li style="margin-bottom: 1.5rem; padding-left: 2rem; position: relative;">
              <span style="position: absolute; left: 0;">→</span>
              <strong>Your patience</strong> as we build this the right way
            </li>
            <li style="margin-bottom: 1.5rem; padding-left: 2rem; position: relative;">
              <span style="position: absolute; left: 0;">→</span>
              <strong>Your voice</strong> when we ask for feedback
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  {% if section.settings.show_faq %}
  <section style="padding: 6rem 0; background-color: rgba(40, 40, 40, 0.5);">
    <div class="page-width">
      <h2 class="h1" style="margin-bottom: 4rem; text-align: center;">FAQ</h2>
      <div style="max-width: 70rem; margin: 0 auto;">
        <div class="mcst-faq-item" style="margin-bottom: 1rem;">
          <button class="mcst-faq-trigger" style="width: 100%; text-align: left; padding: 2rem; background-color: rgba(40, 40, 40, 0.6); border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; border-radius: 8px;">
            <span>Is this a nonprofit?</span>
            <span class="mcst-faq-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-faq-content" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;">
            <div style="padding: 0 2rem 2rem 2rem; background-color: rgba(40, 40, 40, 0.6); border-radius: 0 0 8px 8px;">
              <p>No. We're a social enterprise. That means we can move fast, reinvest profits directly into Chicago neighborhoods, and avoid the red tape that slows down traditional nonprofits. Same mission, different structure.</p>
            </div>
          </div>
        </div>
        <div class="mcst-faq-item" style="margin-bottom: 1rem;">
          <button class="mcst-faq-trigger" style="width: 100%; text-align: left; padding: 2rem; background-color: rgba(40, 40, 40, 0.6); border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; border-radius: 8px;">
            <span>When do I get my Founder's Circle benefits?</span>
            <span class="mcst-faq-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-faq-content" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;">
            <div style="padding: 0 2rem 2rem 2rem; background-color: rgba(40, 40, 40, 0.6); border-radius: 0 0 8px 8px;">
              <p>As soon as we launch. Early access emails go out first to Founder's Circle members. Founder pricing kicks in on our first drop. Community input starts now, we're already listening.</p>
            </div>
          </div>
        </div>
        <div class="mcst-faq-item" style="margin-bottom: 1rem;">
          <button class="mcst-faq-trigger" style="width: 100%; text-align: left; padding: 2rem; background-color: rgba(40, 40, 40, 0.6); border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; border-radius: 8px;">
            <span>What if I change my mind?</span>
            <span class="mcst-faq-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-faq-content" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;">
            <div style="padding: 0 2rem 2rem 2rem; background-color: rgba(40, 40, 40, 0.6); border-radius: 0 0 8px 8px;">
              <p>No problem. Unsubscribe anytime. We're building something people want to be part of, not trapping anyone. If it's not for you, it's not for you.</p>
            </div>
          </div>
        </div>
        <div class="mcst-faq-item" style="margin-bottom: 1rem;">
          <button class="mcst-faq-trigger" style="width: 100%; text-align: left; padding: 2rem; background-color: rgba(40, 40, 40, 0.6); border: none; color: inherit; font-size: 1.6rem; font-weight: 600; cursor: pointer; display: flex; justify-content: space-between; align-items: center; border-radius: 8px;">
            <span>How do you pick which organizations to support?</span>
            <span class="mcst-faq-icon" style="transition: transform 0.3s;">+</span>
          </button>
          <div class="mcst-faq-content" style="max-height: 0; overflow: hidden; transition: max-height 0.3s ease;">
            <div style="padding: 0 2rem 2rem 2rem; background-color: rgba(40, 40, 40, 0.6); border-radius: 0 0 8px 8px;">
              <p>We're vetting now. Looking for organizations with real impact, transparent operations, and alignment with our mission. Founder's Circle members will see the full process, the criteria, and the final decisions. No secrets.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
  {% endif %}

  <!-- Signup -->
  <section id="mcst-signup" style="padding: 8rem 0;">
    <div class="page-width" style="max-width: 60rem;">
      <h2 class="h1" style="margin-bottom: 2rem; text-align: center;">Join the Founder's Circle</h2>
      <p style="text-align: center; margin-bottom: 4rem; font-size: 1.6rem; opacity: 0.8;">Get early access, founder pricing, and direct impact updates.</p>
      
      {% form 'contact', class: 'mcst-signup-form' %}
        <input type="hidden" name="form_type" value="contact">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="founders_circle">
        <input type="hidden" name="contact[context]" value="mcst_coming_soon_{{ section.id }}">

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="email"
            id="mcst-email-{{ section.id }}"
            name="contact[email]"
            class="field__input"
            value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            aria-required="true"
            required
            autocorrect="off"
            autocapitalize="off"
            autocomplete="email"
            placeholder="Email address *"
            {% if form.errors contains 'email' %}
              aria-invalid="true"
              aria-describedby="mcst-email-error-{{ section.id }}"
            {% endif %}
            style="width: 100%; padding: 1.5rem; background-color: rgba(40, 40, 40, 0.6); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 4px; color: inherit; font-size: 1.6rem;"
          >
          {%- if form.errors contains 'email' -%}
            <small class="form__message" id="mcst-email-error-{{ section.id }}" style="display: block; margin-top: 0.5rem; color: #ff0000;">
              {% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
            </small>
          {%- endif -%}
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-firstname-{{ section.id }}"
            name="contact[name]"
            class="field__input"
            value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            autocapitalize="words"
            autocomplete="name"
            placeholder="Name (optional)"
            style="width: 100%; padding: 1.5rem; background-color: rgba(40, 40, 40, 0.6); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 4px; color: inherit; font-size: 1.6rem;"
          >
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-organization-{{ section.id }}"
            name="contact[organization]"
            class="field__input"
            placeholder="Organization (optional)"
            style="width: 100%; padding: 1.5rem; background-color: rgba(40, 40, 40, 0.6); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 4px; color: inherit; font-size: 1.6rem;"
          >
        </div>

        <div class="field" style="margin-bottom: 2rem;">
          <input
            type="text"
            id="mcst-role-{{ section.id }}"
            name="contact[role]"
            class="field__input"
            placeholder="Role (optional)"
            style="width: 100%; padding: 1.5rem; background-color: rgba(40, 40, 40, 0.6); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 4px; color: inherit; font-size: 1.6rem;"
          >
        </div>

        <div class="field" style="margin-bottom: 3rem;">
          <input
            type="text"
            id="mcst-neighborhood-{{ section.id }}"
            name="contact[neighborhood]"
            class="field__input"
            placeholder="Neighborhood (optional)"
            style="width: 100%; padding: 1.5rem; background-color: rgba(40, 40, 40, 0.6); border: 1px solid rgba(255, 255, 255, 0.2); border-radius: 4px; color: inherit; font-size: 1.6rem;"
          >
        </div>

        <button type="submit" class="button button--primary" style="width: 100%; padding: 1.5rem; font-size: 1.6rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.1em;">
          Join the Founder's Circle
        </button>

        {%- if form.posted_successfully? -%}
          <div class="form__message form__message--success" style="margin-top: 2rem; padding: 2rem; background-color: rgba(174, 239, 0, 0.2); border: 1px solid #aeef00; border-radius: 4px; text-align: center;">
            {% render 'icon-success' -%}
            <span style="margin-left: 1rem;">You're in. Welcome to the Founder's Circle.</span>
          </div>
        {%- endif -%}

        <p style="text-align: center; margin-top: 2rem; font-size: 1.2rem; opacity: 0.6;">No spam, no selling your info, ever.</p>
      {% endform %}
    </div>
  </section>

  <!-- Footer -->
  <footer style="padding: 4rem 0; border-top: 1px solid rgba(255, 255, 255, 0.1); text-align: center;">
    <div class="page-width">
      <p style="margin-bottom: 1rem; font-size: 1.6rem; font-weight: 600;">Building something real for Chicago, one block at a time.</p>
      <p style="margin-bottom: 2rem; opacity: 0.7;">Built in Chicago, built to last</p>
      <p style="font-size: 1.2rem; opacity: 0.5;">© {{ 'now' | date: '%Y' }} MyCityStandsTogether. All rights reserved.</p>
    </div>
  </footer>
</div>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const container = document.getElementById('mcst-coming-soon-' + sectionId);
  if (!container) return;

  // Smooth scroll
  container.querySelectorAll('a[href^="#"]').forEach(link => {
    link.addEventListener('click', function(e) {
      const targetId = this.getAttribute('href').substring(1);
      const target = document.getElementById(targetId);
      if (target) {
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  });

  // Rotating text
  const rotateTexts = [
    'Chicago pride, Chicago progress',
    'Built slow, built real',
    'Not for tourists, for us',
    'Wear the city, support the block'
  ];
  const rotateEl = container.querySelector('.mcst-rotate-text');
  if (rotateEl) {
    let currentIndex = 0;
    setInterval(() => {
      currentIndex = (currentIndex + 1) % rotateTexts.length;
      rotateEl.style.opacity = '0';
      setTimeout(() => {
        rotateEl.textContent = rotateTexts[currentIndex];
        rotateEl.style.opacity = '0.7';
      }, 300);
    }, 4000);
  }

  // Hooks accordion
  container.querySelectorAll('.mcst-hook-trigger').forEach(trigger => {
    trigger.addEventListener('click', function() {
      const item = this.closest('.mcst-hook-item');
      const isActive = item.classList.contains('active');
      
      // Close all
      container.querySelectorAll('.mcst-hook-item').forEach(i => {
        i.classList.remove('active');
        i.querySelector('.mcst-hook-icon').textContent = '+';
        i.querySelector('.mcst-hook-icon').style.transform = 'rotate(0deg)';
      });
      
      // Open clicked if it wasn't active
      if (!isActive) {
        item.classList.add('active');
        item.querySelector('.mcst-hook-icon').textContent = '−';
        item.querySelector('.mcst-hook-icon').style.transform = 'rotate(0deg)';
      }
    });
  });

  // FAQ accordion
  container.querySelectorAll('.mcst-faq-trigger').forEach(trigger => {
    trigger.addEventListener('click', function() {
      const item = this.closest('.mcst-faq-item');
      const content = item.querySelector('.mcst-faq-content');
      const icon = item.querySelector('.mcst-faq-icon');
      const isActive = item.classList.contains('active');
      
      // Close all
      container.querySelectorAll('.mcst-faq-item').forEach(i => {
        i.classList.remove('active');
        i.querySelector('.mcst-faq-content').style.maxHeight = '0';
        i.querySelector('.mcst-faq-icon').textContent = '+';
        i.querySelector('.mcst-faq-icon').style.transform = 'rotate(0deg)';
      });
      
      // Open clicked if it wasn't active
      if (!isActive) {
        item.classList.add('active');
        content.style.maxHeight = content.scrollHeight + 'px';
        icon.textContent = '−';
        icon.style.transform = 'rotate(0deg)';
      }
    });
  });

  // Form validation
  const form = container.querySelector('.mcst-signup-form');
  if (form) {
    form.addEventListener('submit', function(e) {
      const emailInput = form.querySelector('input[type="email"]');
      if (!emailInput.value.trim()) {
        e.preventDefault();
        emailInput.style.borderColor = '#ff0000';
        const errorMsg = document.createElement('small');
        errorMsg.className = 'form__message';
        errorMsg.style.display = 'block';
        errorMsg.style.marginTop = '0.5rem';
        errorMsg.style.color = '#ff0000';
        errorMsg.textContent = 'Email is required';
        emailInput.parentNode.appendChild(errorMsg);
        setTimeout(() => {
          emailInput.style.borderColor = 'rgba(255, 255, 255, 0.2)';
          if (errorMsg.parentNode) errorMsg.parentNode.removeChild(errorMsg);
        }, 3000);
      }
    });
  }

  // Intersection Observer for reveal animations
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.opacity = '1';
        entry.target.style.transform = 'translateY(0)';
      }
    });
  }, observerOptions);

  // Observe sections
  container.querySelectorAll('section').forEach(section => {
    section.style.opacity = '0';
    section.style.transform = 'translateY(20px)';
    section.style.transition = 'opacity 0.6s ease, transform 0.6s ease';
    observer.observe(section);
  });
})();
</script>

