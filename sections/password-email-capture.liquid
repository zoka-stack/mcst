<link rel="stylesheet" href="{{ 'section-password-email-capture.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-newsletter.css' | asset_url }}" media="print" onload="this.media='all'">

<noscript>{{ 'section-password-email-capture.css' | asset_url | stylesheet_tag }}</noscript>
<noscript>{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}</noscript>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    {% if section.settings.background_color != blank %}
      background-color: {{ section.settings.background_color }};
    {% endif %}
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .password-email-capture__heading {
    color: {{ section.settings.heading_color | default: '#ffffff' }};
  }

  .password-email-capture__text {
    color: {{ section.settings.text_color | default: '#ffffff' }};
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} gradient password-email-capture section-{{ section.id }}-padding">
  <div class="page-width page-width--narrow">
    <div class="password-email-capture__container">
      {%- if section.settings.heading != blank -%}
        <h1 class="password-email-capture__heading main-page-title page-title {{ section.settings.heading_size }}">
          {{ section.settings.heading | escape }}
        </h1>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="password-email-capture__text password-email-capture__subheading rte">
          {{ section.settings.subheading }}
        </div>
      {%- endif -%}

      <div class="password-email-capture__form-wrapper">
        <h2 class="password-email-capture__form-heading">{{ section.settings.form_heading | default: "Get Notified" }}</h2>
        {%- if section.settings.form_description != blank -%}
          <p class="password-email-capture__form-description">{{ section.settings.form_description | escape }}</p>
        {%- endif -%}

        {% form 'customer', class: 'newsletter-form password-email-capture__form' %}
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="hidden" name="contact[tags]" value="newsletter">
          <input type="hidden" name="contact[context]" value="password-page-{{ section.id }}">

          <div class="newsletter-form__field-wrapper">
            <div class="field">
              <input
                type="email"
                id="PasswordEmail-{{ section.id }}"
                name="contact[email]"
                class="field__input"
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
                aria-required="true"
                required
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="PasswordEmail-error-{{ section.id }}"
                {% endif %}
                placeholder="{{ section.settings.email_placeholder | default: 'Enter your email address' }}"
              >
              <label class="field__label" for="PasswordEmail-{{ section.id }}">
                {{ section.settings.email_label | default: 'Email address' }}
                <span aria-hidden="true">*</span>
              </label>
            </div>
            {%- if form.errors contains 'email' -%}
              <small class="newsletter-form__message form__message" id="PasswordEmail-error-{{ section.id }}">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                <span>{% render 'icon-error' %}{{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}</span>
              </small>
            {%- endif -%}
          </div>

          <button type="submit" class="button newsletter-form__button password-email-capture__submit" name="commit" id="Subscribe">
            <span>{{ section.settings.button_text | default: "Notify Me" }}</span>
            <span class="visually-hidden">{{ 'newsletter.button_label' | t }}</span>
          </button>

          {%- if form.posted_successfully? -%}
            <div class="newsletter-form__message newsletter-form__message--success form__message" tabindex="-1" autofocus>
              {% render 'icon-success' -%}
              <span>{{ section.settings.success_message | default: "Thank you! We'll notify you when we launch." }}</span>
            </div>
          {%- endif -%}
        {% endform %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password Email Capture",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Opening Soon"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>Be the first to know when we launch.</p>"
    },
    {
      "type": "header",
      "content": "Email Form Settings"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form Heading",
      "default": "Get Notified"
    },
    {
      "type": "text",
      "id": "form_description",
      "label": "Form Description",
      "default": "Enter your email to receive updates"
    },
    {
      "type": "text",
      "id": "email_label",
      "label": "Email Label",
      "default": "Email address"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email Placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Notify Me"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success Message",
      "default": "Thank you! We'll notify you when we launch."
    },
    {
      "type": "header",
      "content": "Section Settings"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#282828"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "background-1",
      "label": "Color scheme"
    },
    {
      "type": "header",
      "content": "Section Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Password Email Capture"
    }
  ]
}
{% endschema %}

