{%- style -%}
  #mcst-password-coming-soon-{{ section.id }} {
    position: relative;
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    background: linear-gradient(135deg, #0a0a0a 0%, #1a1a1a 50%, #0a0a0a 100%);
    color: #ffffff;
    font-family: var(--font-body-family, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif);
    overflow: hidden;
    padding: 4rem 2rem;
  }

  #mcst-password-coming-soon-{{ section.id }}::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      radial-gradient(circle at 20% 50%, rgba(174, 239, 0, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 80%, rgba(174, 239, 0, 0.08) 0%, transparent 50%),
      repeating-linear-gradient(0deg, transparent, transparent 2px, rgba(255, 255, 255, 0.02) 2px, rgba(255, 255, 255, 0.02) 4px);
    pointer-events: none;
    z-index: 0;
  }

  #mcst-password-coming-soon-{{ section.id }}::after {
    content: '';
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(circle, rgba(174, 239, 0, 0.03) 0%, transparent 70%);
    animation: pulse 20s ease-in-out infinite;
    pointer-events: none;
    z-index: 0;
  }

  @keyframes pulse {
    0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.5; }
    50% { transform: scale(1.1) rotate(180deg); opacity: 0.8; }
  }

  #mcst-password-coming-soon-{{ section.id }} > * {
    position: relative;
    z-index: 1;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-password-container {
    max-width: 800px;
    width: 100%;
    text-align: center;
    animation: fadeInUp 1s ease-out;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-logo {
    font-size: 3.5rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #aeef00;
    margin-bottom: 2rem;
    font-family: var(--font-heading-family, var(--font-body-family));
    text-shadow: 0 0 20px rgba(174, 239, 0, 0.3);
    animation: glow 3s ease-in-out infinite alternate;
  }

  @keyframes glow {
    from { text-shadow: 0 0 20px rgba(174, 239, 0, 0.3), 0 0 30px rgba(174, 239, 0, 0.2); }
    to { text-shadow: 0 0 30px rgba(174, 239, 0, 0.5), 0 0 40px rgba(174, 239, 0, 0.3); }
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-heading {
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 1.1;
    margin-bottom: 2rem;
    color: #ffffff;
    font-family: var(--font-heading-family, var(--font-body-family));
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-subheading {
    font-size: 2rem;
    font-weight: 300;
    line-height: 1.6;
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.9);
    max-width: 600px;
    margin-left: auto;
    margin-right: auto;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-description {
    font-size: 1.6rem;
    line-height: 1.8;
    margin-bottom: 4rem;
    color: rgba(255, 255, 255, 0.7);
    max-width: 550px;
    margin-left: auto;
    margin-right: auto;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-form-wrapper {
    background: rgba(255, 255, 255, 0.05);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 4rem 3rem;
    margin-top: 3rem;
    box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-form-heading {
    font-size: 2.4rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: #aeef00;
    font-family: var(--font-heading-family, var(--font-body-family));
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-form-description {
    font-size: 1.4rem;
    line-height: 1.6;
    margin-bottom: 3rem;
    color: rgba(255, 255, 255, 0.8);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-form {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-field {
    position: relative;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-field__input {
    width: 100%;
    padding: 1.8rem 2.4rem;
    font-size: 1.6rem;
    background: rgba(255, 255, 255, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 8px;
    color: #ffffff;
    transition: all 0.3s ease;
    font-family: var(--font-body-family);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-field__input:focus {
    outline: none;
    border-color: #aeef00;
    background: rgba(255, 255, 255, 0.15);
    box-shadow: 0 0 0 4px rgba(174, 239, 0, 0.1);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-field__input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-field__label {
    display: block;
    font-size: 1.4rem;
    font-weight: 500;
    margin-bottom: 0.8rem;
    color: rgba(255, 255, 255, 0.9);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-button {
    width: 100%;
    padding: 1.8rem 3rem;
    font-size: 1.6rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: #aeef00;
    color: #000000;
    border: 2px solid #aeef00;
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-family: var(--font-body-family);
    box-shadow: 0 4px 16px rgba(174, 239, 0, 0.3);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-button:hover {
    background: #ffffff;
    border-color: #ffffff;
    transform: translateY(-2px);
    box-shadow: 0 6px 24px rgba(174, 239, 0, 0.4);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-button:active {
    transform: translateY(0);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-button:disabled {
    opacity: 0.6;
    cursor: not-allowed;
    transform: none;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-message {
    padding: 1.5rem 2rem;
    border-radius: 8px;
    margin-top: 2rem;
    font-size: 1.4rem;
    text-align: center;
    animation: slideIn 0.5s ease-out;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateY(-10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-message--success {
    background: rgba(174, 239, 0, 0.2);
    border: 1px solid #aeef00;
    color: #aeef00;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-message--error {
    background: rgba(255, 0, 0, 0.2);
    border: 1px solid #ff0000;
    color: #ff6b6b;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-privacy {
    margin-top: 2rem;
    font-size: 1.2rem;
    color: rgba(255, 255, 255, 0.6);
    text-align: center;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-features {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 3rem;
    margin-top: 5rem;
    padding-top: 5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-feature {
    text-align: center;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-feature__icon {
    width: 64px;
    height: 64px;
    margin: 0 auto 1.5rem;
    background: rgba(174, 239, 0, 0.1);
    border: 2px solid rgba(174, 239, 0, 0.3);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-feature:hover .mcst-feature__icon {
    background: rgba(174, 239, 0, 0.2);
    border-color: #aeef00;
    transform: scale(1.1);
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-feature__icon svg {
    width: 32px;
    height: 32px;
    stroke: #aeef00;
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-feature__title {
    font-size: 1.6rem;
    font-weight: 600;
    margin-bottom: 0.8rem;
    color: #ffffff;
    font-family: var(--font-heading-family, var(--font-body-family));
  }

  #mcst-password-coming-soon-{{ section.id }} .mcst-feature__description {
    font-size: 1.3rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.7);
  }

  @media screen and (max-width: 749px) {
    #mcst-password-coming-soon-{{ section.id }} {
      padding: 3rem 1.5rem;
    }

    #mcst-password-coming-soon-{{ section.id }} .mcst-logo {
      font-size: 2.5rem;
      margin-bottom: 1.5rem;
    }

    #mcst-password-coming-soon-{{ section.id }} .mcst-heading {
      font-size: 3rem;
      margin-bottom: 1.5rem;
    }

    #mcst-password-coming-soon-{{ section.id }} .mcst-subheading {
      font-size: 1.6rem;
      margin-bottom: 1rem;
    }

    #mcst-password-coming-soon-{{ section.id }} .mcst-description {
      font-size: 1.4rem;
      margin-bottom: 3rem;
    }

    #mcst-password-coming-soon-{{ section.id }} .mcst-form-wrapper {
      padding: 3rem 2rem;
    }

    #mcst-password-coming-soon-{{ section.id }} .mcst-form-heading {
      font-size: 2rem;
    }

    #mcst-password-coming-soon-{{ section.id }} .mcst-form-description {
      font-size: 1.3rem;
    }

    #mcst-password-coming-soon-{{ section.id }} .mcst-features {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      margin-top: 4rem;
      padding-top: 4rem;
    }
  }

  @media screen and (min-width: 750px) {
    #mcst-password-coming-soon-{{ section.id }} .mcst-form {
      flex-direction: row;
      align-items: flex-end;
    }

    #mcst-password-coming-soon-{{ section.id }} .mcst-field {
      flex: 1;
    }

    #mcst-password-coming-soon-{{ section.id }} .mcst-button {
      width: auto;
      min-width: 200px;
      flex-shrink: 0;
    }
  }
{%- endstyle -%}

<div id="mcst-password-coming-soon-{{ section.id }}">
  <div class="mcst-password-container">
    <!-- Logo/Brand -->
    <div class="mcst-logo">
      {{ section.settings.logo_text | default: 'MCST' }}
    </div>

    <!-- Main Heading -->
    <h1 class="mcst-heading">
      {{ section.settings.heading | default: 'Something Big is Coming' }}
    </h1>

    <!-- Subheading -->
    {% if section.settings.subheading != blank %}
      <div class="mcst-subheading">
        {{ section.settings.subheading }}
      </div>
    {% endif %}

    <!-- Description -->
    {% if section.settings.description != blank %}
      <div class="mcst-description">
        {{ section.settings.description }}
      </div>
    {% endif %}

    <!-- Email Signup Form -->
    <div class="mcst-form-wrapper">
      <h2 class="mcst-form-heading">
        {{ section.settings.form_heading | default: 'Join the Founder\'s Circle' }}
      </h2>
      
      {% if section.settings.form_description != blank %}
        <p class="mcst-form-description">
          {{ section.settings.form_description }}
        </p>
      {% endif %}

      {% form 'customer', class: 'mcst-signup-form' %}
        <input type="hidden" name="form_type" value="customer">
        <input type="hidden" name="utf8" value="✓">
        <input type="hidden" name="contact[tags]" value="founders_circle,password_page">
        <input type="hidden" name="contact[context]" value="mcst_password_coming_soon_{{ section.id }}">

        {%- if form.errors -%}
          <div class="mcst-message mcst-message--error" role="alert" tabindex="-1" autofocus>
            <h3 style="margin-bottom: 0.5rem; font-size: 1.6rem;">
              {{ 'templates.contact.form.error_heading' | t }}
            </h3>
            <ul style="list-style: none; padding: 0; margin: 0;">
              {%- for field in form.errors -%}
                <li>
                  {%- if field == 'form' -%}
                    {{ form.errors.messages[field] }}
                  {%- else -%}
                    <a href="#mcst-email-{{ section.id }}" style="color: inherit;">
                      {{ form.errors.translated_fields[field] | capitalize }}
                      {{ form.errors.messages[field] }}
                    </a>
                  {%- endif -%}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="mcst-form">
          <div class="mcst-field">
            <label class="mcst-field__label" for="mcst-email-{{ section.id }}">
              {{ section.settings.email_label | default: 'Email address' }}
              <span aria-hidden="true">*</span>
            </label>
            <input
              type="email"
              id="mcst-email-{{ section.id }}"
              name="contact[email]"
              class="mcst-field__input"
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              aria-required="true"
              required
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              placeholder="{{ section.settings.email_placeholder | default: 'Enter your email address' }}"
              {% if form.errors contains 'email' %}
                aria-invalid="true"
                aria-describedby="mcst-email-error-{{ section.id }}"
              {% endif %}
            >
            {%- if form.errors contains 'email' -%}
              <small class="mcst-message mcst-message--error" id="mcst-email-error-{{ section.id }}" style="display: block; margin-top: 0.5rem; padding: 1rem;">
                <span class="visually-hidden">{{ 'accessibility.error' | t }}</span>
                {{ form.errors.translated_fields['email'] | capitalize }} {{ form.errors.messages['email'] }}
              </small>
            {%- endif -%}
          </div>

          <button type="submit" class="mcst-button" name="commit">
            {{ section.settings.button_text | default: 'Join the Founder\'s Circle' }}
          </button>
        </div>

        {%- if form.posted_successfully? -%}
          <div class="mcst-message mcst-message--success" role="status" tabindex="-1" autofocus>
            <strong style="display: block; margin-bottom: 0.5rem;">
              {{ section.settings.success_heading | default: 'Thank you!' }}
            </strong>
            <span>
              {{ section.settings.success_message | default: 'You\'ve been added to the Founder\'s Circle. Check your email for confirmation.' }}
            </span>
          </div>
        {%- endif -%}
      {% endform %}

      {% if section.settings.privacy_text != blank %}
        <p class="mcst-privacy">
          {{ section.settings.privacy_text }}
        </p>
      {% endif %}
    </div>

    <!-- Features/Benefits -->
    {% if section.blocks.size > 0 %}
      <div class="mcst-features">
        {% for block in section.blocks %}
          <div class="mcst-feature" {{ block.shopify_attributes }}>
            {% if block.settings.icon != blank %}
              <div class="mcst-feature__icon">
                {{ block.settings.icon }}
              </div>
            {% else %}
              <div class="mcst-feature__icon">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
              </div>
            {% endif %}
            {% if block.settings.title != blank %}
              <h3 class="mcst-feature__title">{{ block.settings.title }}</h3>
            {% endif %}
            {% if block.settings.description != blank %}
              <p class="mcst-feature__description">{{ block.settings.description }}</p>
            {% endif %}
          </div>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</div>

<script>
(function() {
  const sectionId = '{{ section.id }}';
  const form = document.querySelector('#mcst-password-coming-soon-' + sectionId + ' .mcst-signup-form');
  
  if (form) {
    form.addEventListener('submit', function(e) {
      const button = form.querySelector('.mcst-button');
      const emailInput = form.querySelector('#mcst-email-' + sectionId);
      
      if (button && emailInput) {
        button.disabled = true;
        button.textContent = '{{ section.settings.button_loading_text | default: "Joining..." }}';
        
        // Re-enable after 5 seconds in case of error
        setTimeout(function() {
          button.disabled = false;
          button.textContent = '{{ section.settings.button_text | default: "Join the Founder\'s Circle" }}';
        }, 5000);
      }
    });
  }
})();
</script>

