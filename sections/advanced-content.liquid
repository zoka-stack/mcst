              "label": "100%"
            }
          ]
        },
        {
          "id": "collection",
          "type": "collection",
          "label": "t:sections.all.collection.label"
        },
        {
          "type": "range",
          "id": "limit",
          "min": 1,
          "max": 10,
          "step": 1,
          "default": 10,
          "label": "t:sections.all.limit.label"
        },
        {
          "id": "show_button",
          "type": "checkbox",
          "label": "Show button",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.advanced-content.presets.name",
      "blocks": [
        {
          "type": "image"
        },
        {
          "type": "product"
        }
      ]
